{% doc %}
  @prompt
    Create section where i have slider option with arrow and each blcok content one image ,title and link 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-slider-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: 100%;
    display: block;
  }

  .ai-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-slider-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-slider-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.content_spacing }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-slider-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-slider-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    position: relative;
  }

  .ai-slider-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-slider-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-slider-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.content_spacing }}px;
    font-weight: 600;
  }

  .ai-slider-link-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    transition: background-color 0.3s ease;
  }

  .ai-slider-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-slider-arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.arrow_bg_color }};
    color: {{ block.settings.arrow_color }};
    border: none;
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: background-color 0.3s ease;
  }

  .ai-slider-arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_bg_color }};
  }

  .ai-slider-arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-slider-arrow-prev-{{ ai_gen_id }} {
    left: {{ block.settings.arrow_offset }}px;
  }

  .ai-slider-arrow-next-{{ ai_gen_id }} {
    right: {{ block.settings.arrow_offset }}px;
  }

  .ai-slider-arrow-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.arrow_size }}px * 0.5);
    height: calc({{ block.settings.arrow_size }}px * 0.5);
  }

  .ai-slider-slide-{{ ai_gen_id }} {
    display: none;
  }

  .ai-slider-slide-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-slider-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: {{ block.settings.dots_spacing }}px;
  }

  .ai-slider-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
    padding: 0;
  }

  .ai-slider-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-slider-arrow-{{ ai_gen_id }} {
      width: calc({{ block.settings.arrow_size }}px * 0.8);
      height: calc({{ block.settings.arrow_size }}px * 0.8);
    }

    .ai-slider-arrow-prev-{{ ai_gen_id }} {
      left: calc({{ block.settings.arrow_offset }}px * 0.5);
    }

    .ai-slider-arrow-next-{{ ai_gen_id }} {
      right: calc({{ block.settings.arrow_offset }}px * 0.5);
    }
  }
{% endstyle %}

<slider-component-{{ ai_gen_id }} class="ai-slider-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-slider-wrapper-{{ ai_gen_id }}">
    <div class="ai-slider-slide-{{ ai_gen_id }} active" data-slide="1">
      <div class="ai-slider-content-{{ ai_gen_id }}">
        <div class="ai-slider-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.slide_1_image %}
            <img
              src="{{ block.settings.slide_1_image | image_url: width: 1000 }}"
              alt="{{ block.settings.slide_1_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.slide_1_image.width }}"
              height="{{ block.settings.slide_1_image.height }}"
              class="ai-slider-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-slider-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-slider-empty-state-{{ ai_gen_id }}">
                Add an image for slide 1
              </div>
            </div>
          {% endif %}
        </div>

        {% if block.settings.slide_1_title != blank %}
          <h3 class="ai-slider-title-{{ ai_gen_id }}">{{ block.settings.slide_1_title }}</h3>
        {% endif %}

        {% if block.settings.slide_1_link != blank and block.settings.slide_1_link_text != blank %}
          <a href="{{ block.settings.slide_1_link }}" class="ai-slider-link-{{ ai_gen_id }}">
            {{ block.settings.slide_1_link_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ai-slider-slide-{{ ai_gen_id }}" data-slide="2">
      <div class="ai-slider-content-{{ ai_gen_id }}">
        <div class="ai-slider-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.slide_2_image %}
            <img
              src="{{ block.settings.slide_2_image | image_url: width: 1000 }}"
              alt="{{ block.settings.slide_2_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.slide_2_image.width }}"
              height="{{ block.settings.slide_2_image.height }}"
              class="ai-slider-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-slider-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-slider-empty-state-{{ ai_gen_id }}">
                Add an image for slide 2
              </div>
            </div>
          {% endif %}
        </div>

        {% if block.settings.slide_2_title != blank %}
          <h3 class="ai-slider-title-{{ ai_gen_id }}">{{ block.settings.slide_2_title }}</h3>
        {% endif %}

        {% if block.settings.slide_2_link != blank and block.settings.slide_2_link_text != blank %}
          <a href="{{ block.settings.slide_2_link }}" class="ai-slider-link-{{ ai_gen_id }}">
            {{ block.settings.slide_2_link_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ai-slider-slide-{{ ai_gen_id }}" data-slide="3">
      <div class="ai-slider-content-{{ ai_gen_id }}">
        <div class="ai-slider-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.slide_3_image %}
            <img
              src="{{ block.settings.slide_3_image | image_url: width: 1000 }}"
              alt="{{ block.settings.slide_3_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.slide_3_image.width }}"
              height="{{ block.settings.slide_3_image.height }}"
              class="ai-slider-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-slider-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-slider-empty-state-{{ ai_gen_id }}">
                Add an image for slide 3
              </div>
            </div>
          {% endif %}
        </div>

        {% if block.settings.slide_3_title != blank %}
          <h3 class="ai-slider-title-{{ ai_gen_id }}">{{ block.settings.slide_3_title }}</h3>
        {% endif %}

        {% if block.settings.slide_3_link != blank and block.settings.slide_3_link_text != blank %}
          <a href="{{ block.settings.slide_3_link }}" class="ai-slider-link-{{ ai_gen_id }}">
            {{ block.settings.slide_3_link_text }}
          </a>
        {% endif %}
      </div>
    </div>

    {% if block.settings.show_arrows %}
      <button
        class="ai-slider-arrow-{{ ai_gen_id }} ai-slider-arrow-prev-{{ ai_gen_id }}"
        aria-label="Previous slide"
        data-direction="prev"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button
        class="ai-slider-arrow-{{ ai_gen_id }} ai-slider-arrow-next-{{ ai_gen_id }}"
        aria-label="Next slide"
        data-direction="next"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}
  </div>

  {% if block.settings.show_dots %}
    <div class="ai-slider-dots-{{ ai_gen_id }}">
      <button class="ai-slider-dot-{{ ai_gen_id }} active" aria-label="Go to slide 1" data-slide="1"></button>
      <button class="ai-slider-dot-{{ ai_gen_id }}" aria-label="Go to slide 2" data-slide="2"></button>
      <button class="ai-slider-dot-{{ ai_gen_id }}" aria-label="Go to slide 3" data-slide="3"></button>
    </div>
  {% endif %}
</slider-component-{{ ai_gen_id }}>

<script>
  (function() {
    class SliderComponent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 1;
        this.totalSlides = 3;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll('.ai-slider-slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-slider-arrow-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-slider-arrow-next-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-slider-dot-{{ ai_gen_id }}');

        this.setupEventListeners();
        this.updateSlider();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.navigate('prev'));
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.navigate('next'));
        }

        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const slideNumber = parseInt(e.target.getAttribute('data-slide'));
            this.goToSlide(slideNumber);
          });
        });
      }

      navigate(direction) {
        if (direction === 'prev') {
          this.currentSlide = this.currentSlide === 1 ? this.totalSlides : this.currentSlide - 1;
        } else {
          this.currentSlide = this.currentSlide === this.totalSlides ? 1 : this.currentSlide + 1;
        }

        this.updateSlider();
      }

      goToSlide(slideNumber) {
        this.currentSlide = slideNumber;
        this.updateSlider();
      }

      updateSlider() {
        this.slides.forEach((slide) => {
          const slideNumber = parseInt(slide.getAttribute('data-slide'));
          if (slideNumber === this.currentSlide) {
            slide.classList.add('active');
          } else {
            slide.classList.remove('active');
          }
        });

        this.dots.forEach((dot) => {
          const slideNumber = parseInt(dot.getAttribute('data-slide'));
          if (slideNumber === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });

        if (this.prevButton) {
          this.prevButton.disabled = false;
        }

        if (this.nextButton) {
          this.nextButton.disabled = false;
        }
      }
    }

    customElements.define('slider-component-{{ ai_gen_id }}', SliderComponent{{ ai_gen_id }});
  })();
</script>

