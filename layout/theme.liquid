        "@type": "Answer",
        "text": "A return shipping fee of Rs 50 per order applies. This amount is deducted from your refund."
      }
    },
    {
      "@type": "Question",
      "name": "Can I exchange a product instead of returning it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, exchanges are completely free."
      }
    },
    {
      "@type": "Question",
      "name": "Which items are non-returnable?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Accessories, innerwear, sunglasses, and socks are non-returnable for hygiene and safety reasons."
      }
    }
  ]
}
</script>
