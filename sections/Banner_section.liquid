{% style %}
#shopify-section-{{ section.id }} {
padding-top: {{ section.settings.padding_top }}px;
padding-bottom: {{ section.settings.padding_bottom }}px;
background-color: {{ section.settings.color_background }};
color: {{ section.settings.color_text }};
overflow:hidden;
{% if section.settings.check == true %}
    border-top: 1px solid #00000033;
{% endif %}
}
.bannerimage{
    width:100%;
    height:100%;
    margin-top:{{ section.settings.mt }}px;
}
.fixed-container.fullwidth {
    padding: 0;
    .flex-center-block{
        padding:0px 30px;
    }
}
.fixed-container {
    padding:0px 30px;
}
.index-section .flex-center-block {
    align-items: flex-start;
}
.index-section {
    margin: 0px !important;
}
@media only screen and (max-width: 1800px) {

}
@media only screen and (max-width: 1500px) {

}
@media only screen and (max-width: 991px) {

}
@media only screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
    .bannerimage{
        margin-top:{{ section.settings.mtm }}px;
    }
    .fixed-container.fullwidth {
        .flex-center-block{
            padding:0px 16px;
        }
    }
    .fixed-container {
        padding: 0px 0px 0px 10px;
    }
}
{% endstyle %}

<div class="relative{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }} {% endif %}">
    <div class="fixed-container {% if section.settings.check1 == true  %} fullwidth {% endif %}">
        {% if section.settings.text != blank or section.settings.text1 != blank %}
        <div data-fade class="flex-center-block">
            {% if section.settings.text %}
                <div class="subtitle">{{ section.settings.text }}</div>
            {% endif %}
            {% if section.settings.text1 %}
             <h2>{{ section.settings.text1 }}</h2>
            {% endif %}
        </div>
        {% endif %}
        {% if section.settings.image %}
            <img data-fade width="" height="" class="bannerimage desktop-only" src="{{ section.settings.image | img_url: 'master'  }}" alt="{{ section.settings.image.alt }}">
        {% endif %}
        {% if section.settings.image1 %}
            <img data-fade width="" height="" class="bannerimage mobile-only" src="{{ section.settings.image1 | img_url: 'master'  }}" alt="{{ section.settings.image1.alt }}">
        {% else %}
            <img data-fade width="" height="" class="bannerimage mobile-only" src="{{ section.settings.image | img_url: 'master'  }}" alt="{{ section.settings.image.alt }}">
        {% endif %}
    </div>
</div>
<script>

</script>
{% schema %}
{
"name": "Banner",
"class": "index-section banners",
"settings": [
{
"type": "text",
"id": "custom_class",
"label": "Custom Class"
},
{
"type": "image_picker",
"id": "image",
"label": "Desktop Image"
},
{
"type": "image_picker",
"id": "image1",
"label": "Mobile Image"
},
{
"type": "text",
"id": "text",
"label": "Tag Line"
},
{
"type": "richtext",
"id": "text1",
"label": "Title"
},
{
"type": "range",
"id": "mt",
"min": 0,
"max": 120,
"step": 4,
"unit": "px",
"label": "Banner Margin Top Desktop",
"default": 36
},
{
"type": "range",
"id": "mtm",
"min": 0,
"max": 120,
"step": 4,
"unit": "px",
"label": "Banner Margin Top Mobile",
"default": 24
},
{
"type": "range",
"id": "padding_top",
"min": 0,
"max": 120,
"step": 4,
"unit": "px",
"label": "Desktop Padding Top",
"default": 36
},
{
"type": "range",
"id": "padding_bottom",
"min": 0,
"max": 120,
"step": 4,
"unit": "px",
"label": "Desktop Padding Bottom",
"default": 36
},
{
"type": "range",
"id": "mobile_padding_top",
"min": 0,
"max": 52,
"step": 2,
"unit": "px",
"label": "Mobile Padding Top",
"default": 20
},
{
"type": "range",
"id": "mobile_padding_bottom",
"min": 0,
"max": 52,
"step": 2,
"unit": "px",
"label": "Mobile Padding Bottom",
"default": 20
},
{
"type": "color",
"id": "color_text",
"label": "Text Color"
},
{
"type": "color",
"id": "color_background",
"label": "Background Color"
},        
{
    "type": "checkbox",
    "id": "check",
    "label": "Border Top"
},
{
    "type": "checkbox",
    "id": "check1",
    "label": "Full width"
},
],
"presets": [
{
"name": "Banner",
}
]
}
{% endschema %}