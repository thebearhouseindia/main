{% style %}
#shopify-section-{{ section.id }} {
padding-top: {{ section.settings.padding_top }}px;
padding-bottom: {{ section.settings.padding_bottom }}px;
background-color: {{ section.settings.color_background }};
color: {{ section.settings.color_text }};
overflow:hidden;
.center-block-contnt {padding: 0px 50px;}
.fixed-container {
    padding: 0;
}
.flex-row-block {
    margin-bottom: 0;
}
.center-block-contnt {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
}

.arrow-wrap {
    position: absolute;
    right:50px;;
}
}
.swiper-slide-inside {
    flex: none;
    width: 20%;
}
.swiper-inside {
    overflow: hidden;
}

@media only screen and (max-width: 768px) {
#shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    .flex-row-block {
        width: 100%;
    }
    .center-block-contnt {
        align-items: flex-start;
        padding: 0px 10px;
    }
    .arrow-wrap {
        position: relative;
        right: 0;
    }
}
}
@media only screen and (max-width: 390px) {

}
{% endstyle %}

<div gsap-fadin-anim class="relative{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }} {% endif %}">
    <div class="fixed-container">
        <div data-fade class="center-block-contnt">
            {% if section.settings.title != blank %}
                <h2>{{ section.settings.title }}</h2>
            {% endif %}
            <div class="flex-row-block">
                <div class="tab-wrap">
                    {% for block in section.blocks %}
                        <div data-id="tab_is-{{ forloop.index }}" class="tab-button">{{ block.settings.text }}</div>
                    {% endfor %}
                    <div class="tabsline"><span class="inline-line"></span></div>
                </div>
                <div class="arrow-wrap">
                    <div class="arrow is-prev is-prev-{{ section.id }}">{% render 'Arrow-prev' %}</div>
                    <div class="arrow is-next is-next-{{ section.id }}">{% render 'Arrow-next' %}</div>
                </div>
            </div>
        </div>
       <div data-fade class="tab-content-wrap">
            {% for block in section.blocks %}
                <div data-id="tab_is-{{ forloop.index }}" class="tab-content">
                    <div class="swiper-inside">
                        <div class="swiper-wrapper-inside">
                            {% assign collection = block.settings.collection %}
                            {% for product in collection.products %}
                                <div class="swiper-slide-inside new-product-card">
                                    {%- render 'product-grid-item',
                                        product: product,
                                        quick_shop_enable: settings.quick_shop_enable,
                                    -%}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endfor %}
       </div>
    </div>
</div>
<script>
document.addEventListener("DOMContentLoaded", function() {
    $("#shopify-section-{{ section.id }}").each(function () {
        var $section = $(this);
        $section.find(".tab-button").on("click", function () {
            var tabId = $(this).data("id");
            $section.find(".tab-button").removeClass("active");
            $(this).addClass("active");
            $section.find(".tab-content").removeClass("active");
            var $activeTab = $section.find('.tab-content[data-id="' + tabId + '"]');
            $activeTab.addClass("active");
            moveUnderline();
            initSwiperForTab($activeTab);
        });
        var $firstBtn = $section.find(".tab-button").first();
        $firstBtn.addClass("active");
        $firstBtn.trigger("click");
        function moveUnderline() {
            var $active = $section.find(".tab-button.active");
            if (!$active.length) return;

            var leftPos = $active.position().left;
            var tabWidth = $active.outerWidth();

            $section.find(".inline-line").css({
                width: tabWidth + "px",
                transform: "translateX(" + leftPos + "px)"
            });
        }
        function initSwiperForTab($tab) {
            var $swiperContainer = $tab.find(".swiper-inside");
            if ($swiperContainer.hasClass("swiper-initialized")) return;
            new Swiper($swiperContainer[0], {
                wrapperClass: 'swiper-wrapper-inside',
                slideClass: 'swiper-slide-inside',
                slidesPerView: 5,
                spaceBetween: 4,
                navigation: {
                    nextEl: ".is-next-{{ section.id }}",
                    prevEl: ".is-prev-{{ section.id }}",
                },
                breakpoints: {
                    320: { slidesPerView: 1.5 },
                    480: { slidesPerView: 2 },
                    768: { slidesPerView: 3 },
                    1024: { slidesPerView: 4 },
                    1280: { slidesPerView: 5 },
                }
            });
            $swiperContainer.addClass("swiper-initialized");
        }
        $(window).on("resize", function () {
            moveUnderline();
        });
    });
});
</script>

{% schema %}
{
"name": "Collection Tab",
"class": "collection_tab",
"settings": [
{
"type": "text",
"id": "custom_class",
"label": "Custom Class"
},
{
"type": "text",
"id": "title",
"label": "Title"
},
{
"type": "range",
"id": "padding_top",
"min": 0,
"max": 120,
"step": 4,
"unit": "px",
"label": "Desktop Padding Top",
"default": 36
},
{
"type": "range",
"id": "padding_bottom",
"min": 0,
"max": 120,
"step": 4,
"unit": "px",
"label": "Desktop Padding Bottom",
"default": 36
},
{
"type": "range",
"id": "mobile_padding_top",
"min": 0,
"max": 120,
"step": 4,
"unit": "px",
"label": "Mobile Padding Top",
"default": 20
},
{
"type": "range",
"id": "mobile_padding_bottom",
"min": 0,
"max": 120,
"step": 4,
"unit": "px",
"label": "Mobile Padding Bottom",
"default": 20
},
{
"type": "color",
"id": "color_text",
"label": "Text Color"
},
{
"type": "color",
"id": "color_background",
"label": "Background Color"
}
],
"blocks": [
{
"type": "block",
    "name": "Collection",
        "settings": [
            {
                "type": "text",
                "id": "text",
                "label": "Title"
            },
            {
                "type": "collection",
                "id": "collection",
                "label": "Select Collection"
            },
        ]
    }
],
"presets": [
{
"name": "Collection Tab",
}
]
}
{% endschema %}