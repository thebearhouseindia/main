{% style %}
#shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.color_background }};
    color: {{ section.settings.color_text }};
    overflow:hidden;
    position:relative;
    {% if section.settings.check1 == true %}
        border-top:1px solid #3F3F3F26;
    {% endif %}
    {% if section.settings.check2 == true %}
        .fixed-container{
            padding:0px;
        }
        .flex-center-block {
            padding: 0px 50px;
        }
    {% endif %}
    .collection-item-names {
      font-size: {{ section.settings.font-size }}px;  
      color: {{ section.settings.color_text1 }}; 
    }
}

.collection-list-slide{
    display:flex;
    cursor:pointer;
    position:relative;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;    
    overflow: hidden;
    &:hover{
      img.collection-list_image  {
          scale: 1.1;
      }
      .collection-item-names{
          background-size: 100% 1px;
      }
    }
}
.collection-item-names {
    position: absolute;
    margin-bottom: 24px;
    z-index: 1;
    font-family: Roboto;
    font-weight: 400;
    line-height: 120%;
    letter-spacing: 0;
    text-align: center;
    text-transform: uppercase;
    background: linear-gradient(currentColor, currentColor) bottom left / 0% 1px no-repeat;
    transition: background-size 0.3s ease-out;
    padding-bottom: 2px;
}
img.collection-list_image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: 0.5s;
}
.collection-list-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 4px;
}
.collection-list-slide:after {
    bottom: 0;
    content: '';
    position: absolute;
    width: 100%;
    height: 80%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 62.86%, rgba(0, 0, 0, 0.7) 100%);
    pointer-events: none;
}
@media only screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
        {% if section.settings.check2 == true %}
          .fixed-container{
              padding:0px 10px;
          }
          .flex-center-block {
              padding: 0px;
          }
      {% endif %}
      .collection-item-names {
          font-size: {{ section.settings.m_font-size }}px;
      }
    }
    .collection-list-wrapper {
        grid-template-columns: 1fr 1fr;
        gap: 2px;
    }
    .collection-item-names {
      margin-bottom: 8px;
  }
}
{% endstyle %}
<div class="section-relative{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }} {% endif %}">
    <div class="fixed-container">
        {% if section.settings.text != blank %}
            <div data-fade class="flex-center-block">
                <h2>{{ section.settings.text }}</h2>
            </div>
        {% endif %}
<div  class="collection-list-swiper">
  <div class="collection-list-wrapper">
    {% for block in section.blocks %}
      {% assign collection = block.settings.text %}
      {% if block.settings.image != blank %}
        {% assign display_image = block.settings.image %}
      {% elsif collection != blank and collection.image != blank %}
        {% assign display_image = collection.image %}
      {% else %}
        {% assign display_image = blank %}
      {% endif %}
      {% if block.settings.title != blank %}
        {% assign display_title = block.settings.title %}
      {% elsif collection != blank %}
        {% assign display_title = collection.title %}
      {% else %}
        {% assign display_title = '' %}
      {% endif %}
      <div data-fade class="collection-list-slide">
        
        {% if display_image != blank %}
          <img
            width=""
            height=""
            class="collection-list_image"
            src="{{ display_image | img_url: 'master' }}"
            alt="{{ display_title | escape }}"
            loading="lazy"
          >
        {% endif %}

        {% if display_title != blank %}
          <div class="collection-item-names">{{ display_title }}</div>
        {% endif %}

        {% if collection != blank %}
          <a class="collection-link" href="{{ collection.url }}"></a>
        {% endif %}

      </div>
    {% endfor %}
  </div>
</div>

    </div>
</div>
<script>

</script>
{% schema %}
{
"name": "Shop Collection List V2",
"class": "shop-collection-V2",
"settings": [
{
"type": "text",
"id": "custom_class",
"label": "Custom Class"
},
{
"type": "text",
"id": "text",
"label": "Title"
},
{
"type": "checkbox",
"id": "check1",
"label":"Border Top"
},
{
"type": "checkbox",
"id": "check2",
"label":"Page Full Widh"
},
{
"type": "range",
"id": "font-size",
"min": 12,
"max": 24,
"step": 1,
"unit": "px",
"label": "Box Font Size",
"default": 14
},
{
"type": "range",
"id": "m_font-size",
"min": 10,
"max": 18,
"step": 1,
"unit": "px",
"label": "Box Font Size Mobile",
"default": 12
},
{
"type": "range",
"id": "padding_top",
"min": 0,
"max": 120,
"step": 4,
"unit": "px",
"label": "Desktop Padding Top",
"default": 36
},
{
"type": "range",
"id": "padding_bottom",
"min": 0,
"max": 120,
"step": 4,
"unit": "px",
"label": "Desktop Padding Bottom",
"default": 36
},
{
"type": "range",
"id": "mobile_padding_top",
"min": 0,
"max": 52,
"step": 4,
"unit": "px",
"label": "Mobile Padding Top",
"default": 20
},
{
"type": "range",
"id": "mobile_padding_bottom",
"min": 0,
"max": 52,
"step": 4,
"unit": "px",
"label": "Mobile Padding Bottom",
"default": 20
},
{
"type": "color",
"id": "color_text",
"label": "Text Color"
},
{
"type": "color",
"id": "color_text1",
"label": "Block Text Color"
},
{
"type": "color",
"id": "color_background",
"label": "Background Color"
}
],
"blocks": [
{
"type": "block",
"name": "Block",
"settings": [
    {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
    },
    {
        "type": "text",
        "id": "title",
        "label": "Title"
    },
    {
    "type": "collection",
    "id": "text",
    "label": "Select Collection"
    },
]
}
],
"presets": [
{
"name": "Shop Collection List V2",
}
]
}
{% endschema %}