{% style %}
#shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 30px;
    padding-right: 30px;
    overflow:hidden;
    position:relative;
}
img.store_image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(80%);
    transition: all 0.1s ease-in-out;
}
.store-flex:hover img.store_image {
    filter: none;
}
.store-wrapper {
    display: flex;
}
.store_section h2{
    color:#3F3F3F;
}
.top-left-side  a {
    font-weight: 400;
    font-size: 14px;
    line-height: 150%;
    letter-spacing: 0;
    text-transform: uppercase;
    cursor: pointer;
    color: #3F3F3F;
    text-decoration: underline;
    text-underline-offset: 6px;
}
.top-left-side {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 300px;
}
.store-swiper {
    margin-top: 24px;
    overflow:hidden;
}
.store-swiper.swiper-horizontal .store-slide {
    flex: none;
    background: rgba(234, 234, 234, 0.6);
    box-sizing: border-box;
    border: 1px solid rgba(63, 63, 63, 0.1);
    border-radius: 10px;
    overflow: hidden;
}
.store-title {
    font-family: Roboto;
    font-weight: 400;
    font-size: 14px;
    line-height: 130%;
    letter-spacing: 0;
    text-transform: uppercase;
    margin-bottom: 16px;
}
.store-flex{
    height: 100%;
    display: flex;
    flex-direction: column;
}
.store-title h3 {
    font-family: Roboto;
    font-weight: 400;
    font-size: 18px;
    line-height: 130%;
    letter-spacing: 0;
    text-transform: uppercase;
    margin-bottom: 8px;
}

.store-title a {
    margin-top: 12px;
    display: block;
    font-family: Roboto;
    font-weight: 400;
    font-size: 14px;
    line-height: 130%;
    letter-spacing: 0;
    text-decoration: underline;
    text-decoration-style: solid;
    text-decoration-thickness: 0%;
    text-decoration-skip-ink: auto;
}
.store_links {
    display: flex;
    gap: 4px;
}
.store_inner {
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    height: 100%;
}
.store_section .store-link {
    padding: 10px;
    background: #ffffff;
    border:1px solid  #ffffff;
    border-radius: 100%;
    display: flex;
    transition: all 0.3s ease-in-out;
}
.store_section .store-link:hover {
    background: #EDEDED;
    border: 1px solid #3f3f3f;
}
.store-link-inner {
    display: flex;
}
.store_section {
    padding: 60px;
    background:#ffffff;
    position: relative;
    border-radius: 10px;
}
.store_section:before {
    position: absolute;
    /* content: ""; */
    content: none;
    right: 0;
    top: 0;
    max-width: 15%;
    width: 100%;
    height: 100%;
    /* background: linear-gradient(to right, transparent 0%, #EDEDED 100%); */
    background: linear-gradient(270deg, #EFEFEF 0%, rgba(239, 239, 239, 0) 100%);
    z-index: 1;
}
.store_section .flex-left-block {
    display: flex;
    text-align: left;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    z-index: 2;
    position: relative;
    flex-direction: row;
}
.store_section .store-navigation {
    display: flex;
    gap: 4px;
}

.store_section .store-button-prev,
.store_section .store-button-next {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transition: 0.3s ease;
    background: #e92e30;

    svg path {
        stroke: #ffffff;
    }
}

.store_section .store-button-prev:hover,
.store_section .store-button-next:hover {
    background: #ffefef;

    svg path {
        stroke: #3F3F3F;
    }
}
.store_section .swiper-button-disabled {
    cursor: not-allowed;
}
.store-scrollbar {
    display: none;
}
@media only screen and (max-width: 768px) {
.top-left-side {
    width: 100%;
    padding: 0px 10px;
}
    .store-scrollbar {
        background: rgba(63, 63, 63, 0.1);   
        border-radius: 10px;
        height: 2px !important;   
        display: block;
    }
    .store-wrapper {
        padding-bottom: 20px;
    }
    .store-scrollbar .swiper-scrollbar-drag {
        background: #3f3f3f;
        border-radius: 10px;
    }
.store-slide.swiper-slide-active img.store_image {
    filter: unset;
}
    #shopify-section-{{ section.id }} {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
        .flex-center-block{
            padding:0px 10px;
        }
        .fixed-container {
            padding: 0px 0px;
        }
    }
    .store_section {
        padding: 24px 0px 24px 14px;
    }
    .store-title {
        font-size: 12px;
        margin-bottom: 6px;
    }
    .store-navigation {
        display: none !important;
    }
    .store-swiper {
        margin-top: 12px;
    }
    .store_section .store-link {
        padding: 6px;
    }
    .store_section:before {
        content: none;
    }
    .store_inner {
        padding: 10px;
    }
}
{% endstyle %}
<div class="section-relative{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }} {% endif %}">
    <div class="section-container store_section">
        <div data-fade class="flex-left-block">
            <div class="top-left-side">
            <h2>{{ section.settings.text }}</h2>
            <a  href="{{ section.settings.linkstore}}"  class="view-all-store">{{section.settings.View_All}}</a>
            </div>
            <div class="store-navigation">
                <div class="store-button-prev">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12.5 5L7.5 10L12.5 15" stroke="#3F3F3F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>

                <div class="store-button-next">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7.5 5L12.5 10L7.5 15" stroke="#3F3F3F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
            </div>
        </div>

        <div data-fade class="store-swiper store-{{ section.id }}">
            <div class="store-wrapper">
                {% for block in section.blocks %}
                    <div class="store-slide">
                        <div class="store-flex">
                            {% if block.settings.image != blank %}
                                <div class="store-wrap">
                                    <img class="store_image" src="{{ block.settings.image | image_url }}" width="" height="" alt="{{ block.settings.image.alt }}" loading="lazy">
                                </div>
                            {% endif %}
                            <div class="store_inner">
                                <div class="store-title">{{ block.settings.title }}</div>
                                    <div class="store_links">
                                        <div>
                                            <a class="store-link" target="_blank" href="{{ block.settings.store_link }}" aria-label="{{ block.settings.title | default: 'The Bear House - Store' | escape }} location on Google Maps">
                                                <div class="store-link-inner">
                                                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <path d="M15 7.5C15 11.2448 10.8457 15.1447 9.45075 16.3492C9.32079 16.447 9.1626 16.4998 9 16.4998C8.8374 16.4998 8.67921 16.447 8.54925 16.3492C7.15425 15.1447 3 11.2448 3 7.5C3 5.9087 3.63214 4.38258 4.75736 3.25736C5.88258 2.13214 7.4087 1.5 9 1.5C10.5913 1.5 12.1174 2.13214 13.2426 3.25736C14.3679 4.38258 15 5.9087 15 7.5Z" stroke="#3F3F3F" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                                                    <path d="M9 9.75C10.2426 9.75 11.25 8.74264 11.25 7.5C11.25 6.25736 10.2426 5.25 9 5.25C7.75736 5.25 6.75 6.25736 6.75 7.5C6.75 8.74264 7.75736 9.75 9 9.75Z" stroke="#3F3F3F" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                </div>
                                            </a>
                                        </div>
                                        <div>
                                           <a class="store-link" href="{{ block.settings.phone_link }}" aria-label="Call {{ block.settings.title | default: 'The Bear House - Store' | escape }}">
                                                <div class="store-link-inner">
                                                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <path d="M10.2824 12.1976C10.427 12.264 10.5898 12.2792 10.7442 12.2406C10.8985 12.2021 11.0351 12.1121 11.1315 11.9855L11.38 11.66C11.5104 11.4861 11.6795 11.345 11.8739 11.2478C12.0683 11.1506 12.2827 11.1 12.5 11.1H14.6C14.9713 11.1 15.3274 11.2475 15.5899 11.5101C15.8525 11.7726 16 12.1287 16 12.5V14.6C16 14.9713 15.8525 15.3274 15.5899 15.5899C15.3274 15.8525 14.9713 16 14.6 16C11.2583 16 8.05341 14.6725 5.69045 12.3095C3.3275 9.94659 2 6.74173 2 3.4C2 3.0287 2.1475 2.6726 2.41005 2.41005C2.6726 2.1475 3.0287 2 3.4 2H5.5C5.8713 2 6.2274 2.1475 6.48995 2.41005C6.7525 2.6726 6.9 3.0287 6.9 3.4V5.5C6.9 5.71734 6.8494 5.9317 6.7522 6.1261C6.655 6.3205 6.51387 6.48959 6.34 6.62L6.0124 6.8657C5.88389 6.96382 5.79331 7.10341 5.75605 7.26075C5.71879 7.41808 5.73715 7.58346 5.808 7.7288C6.76468 9.67191 8.3381 11.2434 10.2824 12.1976Z" stroke="#3F3F3F" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="swiper-scrollbar store-scrollbar"></div>

        </div>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const swiperstore = new Swiper('.store-{{ section.id }}', {
        slidesPerView: {{ section.settings.range }},
        spaceBetween: 6,
        wrapperClass: 'store-wrapper',
        slideClass: 'store-slide',
        scrollbar: {
            el: '.store-scrollbar',
            draggable: true,
            hide: false,
        },
        navigation: {
            nextEl: '.store-button-next',
            prevEl: '.store-button-prev',
        },

        breakpoints: {
            0: { slidesPerView:1.75 },
            320: { slidesPerView: 1.75 },
            600: { slidesPerView: 1.75 },
            768: { slidesPerView: {{ section.settings.range | minus:'1' }}},
            991: { slidesPerView: {{ section.settings.range | minus:'1' }}},
            1336: { slidesPerView: {{ section.settings.range }}},
        },
    }); 
});

</script>
{% schema %}
{
"name": "Store List",
"class": "store-list",
"settings": [
{
"type": "text",
"id": "custom_class",
"label": "Custom Class"
},
{
"type": "text",
"id": "text",
"label": "Title"
},
{
"type": "url",
"id": "linkstore",
"label": "Store Page"
},
{
"type": "text",
"id": "View_All",
"label": "View All",
"default":"View All"
},
{
"type": "range",
"id": "range",
"min": 2,
"max": 8,
"step": 0.1,
"unit": "px",
"label": "Store Pre View",
"default": 4.1
},
{
"type": "range",
"id": "padding_top",
"min": 0,
"max": 120,
"step": 2,
"unit": "px",
"label": "Desktop Padding Top",
"default": 36
},
{
"type": "range",
"id": "padding_bottom",
"min": 0,
"max": 120,
"step": 2,
"unit": "px",
"label": "Desktop Padding Bottom",
"default": 36
},
{
"type": "range",
"id": "mobile_padding_top",
"min": 0,
"max": 52,
"step": 2,
"unit": "px",
"label": "Mobile Padding Top",
"default": 20
},
{
"type": "range",
"id": "mobile_padding_bottom",
"min": 0,
"max": 52,
"step": 2,
"unit": "px",
"label": "Mobile Padding Bottom",
"default": 20
},
],
"blocks": [
{
"type": "block",
"name": "Block",
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "richtext",
            "id": "title",
            "label": "Title"
        },
        {
            "type": "url",
            "id": "store_link",
            "label": "Store link"
        },
        {
            "type": "url",
            "id": "phone_link",
            "label": "Phone link"
        },
    ]
}
],
"presets": [
{
"name": "Store List",
}
]
}
{% endschema %}