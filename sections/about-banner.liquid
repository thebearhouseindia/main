<style>
    .simple-banner-main {
        padding: 23px 30px 0px;
    }
    .simple-banner-wrapper {
        width: 100%;
        position: relative;
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        border-radius: 10px;
        overflow: hidden;
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
        background-image: url({{ section.settings.bg_image | image_url }});
    }
    .simple-banner-content {
        position: relative;
        width: 100%;
        height: 100%;
        text-align: center;
    }
    .simple-banner-text {
        font-family: Roboto;
        font-weight: 500;
        font-size: 28px;
        line-height: 100%;
        letter-spacing: 0%;
        text-align: center;
        text-transform: uppercase;
        color: {{ section.settings.text_color }};
    }
    @media(max-width: 768px) {
      .simple-banner-main {
        padding: 0px;
      }
      .simple-banner-text {
        font-size: 16px;
      }
      .simple-banner-wrapper {
        border-radius: 0px;
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }
    }
</style>

<section class="simple-banner-main">
    <div class="simple-banner-wrapper">
        <div class="simple-banner-content">
            <div class="simple-banner-text">
            {{ section.settings.heading }}
            </div>
        </div>
    </div>
</section>

{% schema %}
{
  "name": "About us banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Center Heading Text",
      "default": "GET TO KNOW US"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding Desktop",
      "min": 20,
      "max": 100,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding Desktop",
      "min": 20,
      "max": 100,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top Padding Mobile",
      "min": 20,
      "max": 100,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom Padding Mobile",
      "min": 20,
      "max": 100,
      "default": 80
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "About us banner"
    }
  ]
}
{% endschema %}
