<section class="about-video-section {{ section.settings.custom_class }}">
  <div class="about-video-inner">

    <div class="about-video-left">
      {% if section.settings.video != blank %}
        <div class="video-square">
          <video autoplay muted loop playsinline>
            <source src="{{ section.settings.video }}" type="video/mp4">
          </video>
        </div>

      {% elsif section.settings.image != blank %}
        <div class="image-square">
          <img 
            src="{{ section.settings.image | image_url }}" width="" height=""
            alt="Section Image">
        </div>
      {% endif %}

    </div>

    <div class="about-video-right">
      <div data-fade class="about-inner">
        {% if section.settings.heading != blank %}
            <h2>{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
            <div class="desc">{{ section.settings.description }}</div>
        {% endif %}

        <div class="feature-grid">
            {% for block in section.blocks %}
            <div class="feature-item">
                {% if block.settings.icon != blank %}
                <img src="{{ block.settings.icon | image_url }}" alt="Image" width="" height="">
                {% endif %}
                <p>{{ block.settings.text }}</p>
            </div>
            {% endfor %}
        </div>
      </div>
    </div>

  </div>
</section>

{% style %}
.about-video-section .about-video-inner {
  display: flex;
}
.about-video-section .about-video-left {
  display: flex;
}
.about-video-section .about-video-left video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.about-video-section {
  width: 100%;
}
.about-video-section .about-video-left,
.about-video-section .about-video-right {
  width: 50%;
  border-radius: 10px;
  overflow: hidden;
}
.about-video-section .about-video-right {
  background-color: {{ section.settings.box_bg }};
  display: flex;
  align-items: center;
}

.about-video-section .about-video-inner {
  max-width: 100%;
  padding: 0px 30px;
  width: 100%;
  margin: 0 auto;
  display: flex;
  align-items: stretch;
  gap: 6px;
}

.about-video-section .about-inner {
    max-width: 65%;
    width: 100%;
    margin: auto;
}

.about-video-section .video-square {
  width: 100%;
  height: 680px;
  overflow: hidden;
  position: relative;
}

.about-video-section .video-square video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.about-video-section .about-video-right h2 {
  font-size: 28px;
  text-transform: uppercase;
  margin-bottom: 40px;
  color: {{ section.settings.box_text }};
  font-weight: 500;
}

.about-video-section .about-video-right .desc {
    font-size: 15px;
    line-height: 150%;
    color: {{ section.settings.box_text }};
    margin-bottom: 60px;
    max-width: 450px;
    width: 100%;
}

.about-video-section .feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 60px;
}
.about-video-section .about-video .video-square {
  height: 100%;
}
.about-video-section .feature-item {
  display: flex;
  gap: 20px;
  align-items: center;
}

.about-video-section .feature-item img {
  width: 40px;
  height: auto;
}

.about-video-section .feature-item p {
  font-size: 15px;
  color: {{ section.settings.box_text }};
  line-height: 150%;
  margin: 0;
  text-transform: uppercase;
  font-weight: 400;
}
.about-video-section.about-video .about-video-inner {
  flex-direction: row-reverse;
  padding: 30px 30px;
}
@media (max-width: 1551px) {
  .about-video-section .about-inner {
      /* max-width: 90%; */
        display: flex;
        flex-direction: column;
        justify-content: center;
  }
  .about-video-section .video-square {
    height: 500px;
  }
.about-video-section .feature-item {
    align-items: flex-start;
}

}

@media(max-width:1536px){
.about-video-section .feature-grid {
    gap: 30px;
}

.about-video-section .about-video-right .desc {
    margin-bottom: 30px;
}

.about-video-section .about-video-right h2 {
    margin-bottom: 20px;
}
}
@media (max-width: 768px) {
    .about-video-section .about-video-right h2 {
      font-size: 16px;
      margin-bottom: 16px;
    }
    .about-video-section .about-inner {
      max-width: 100%;
      padding: 24px;
    }
    .about-video-section .video-square {
      height: 450px;
    }
    .about-video-section .feature-item img {
      width: 20px;
      height: auto;
    }
    .about-video-section .about-video-right .desc {
      font-size: 14px;
      margin-bottom: 24px;
      max-width: 100%;
    }
    .about-video-section .about-video-inner {
      flex-direction: column;
      padding: 0px 10px;
    }

    .about-video-section .about-video-left,
    .about-video-section .about-video-right {
      width: 100%;
    }

    .about-video-section .feature-grid {
      grid-template-columns: 1fr;
      gap: 9px;
    }
    .about-video-section .feature-item {
      gap: 10px;
    }
    .about-video-section .feature-item p {
      font-size: 12px;
    }
    .about-video-section.about-video .about-video-inner {
      padding: 10px 10px;
      flex-direction: column;
    }
}
{% endstyle %}

{% schema %}
{
  "name": "Video features section",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "text",
      "id": "video",
      "label": "Video URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ABOUT US"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Trusted by 5M+ consumers across India, we’ve developed 8000+ styles, maintain 100% in-house QC, and reach 450+ cities nationwide."
    },
    {
      "type": "color",
      "id": "box_bg",
      "label": "Box bg color",
      "default": "#3f3f3f"
    },
    {
      "type": "color",
      "id": "box_text",
      "label": "Box text color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon / Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "HAND-CHECKED STITCHING"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video features section"
    }
  ]
}
{% endschema %}
