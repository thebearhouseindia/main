{%- liquid
  assign bg = section.settings.bg_color | default: '#e92e30'
  assign fg = section.settings.text_color | default: '#ffffff'
  assign btn_bg = section.settings.button_bg | default: '#ffffff'
  assign btn_fg = section.settings.button_text | default: '#e92e30'
-%}

{% style %}
  #acb-{{ section.id }} {
    --acb-bg: {{ bg }};
    --acb-fg: {{ fg }};
    --acb-btn-bg: {{ btn_bg }};
    --acb-btn-fg: {{ btn_fg }};
    background: var(--acb-bg);
    color: var(--acb-fg);
    width: 100%;
  }
  #acb-{{ section.id }} .acb-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 12px 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    flex-wrap: wrap;
    position: relative;
  }
  #acb-{{ section.id }} .acb-msg {
    margin: 0;
    font-weight: 800;
    font-size: clamp(13px, 1.4vw, 17px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.1;
  }
  #acb-{{ section.id }} .acb-timer {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-variant-numeric: tabular-nums;
  }
  #acb-{{ section.id }} .acb-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 30px;
  }
  #acb-{{ section.id }} .acb-num {
    font-weight: 800;
    font-size: clamp(16px, 1.8vw, 22px);
    line-height: 1;
    font-feature-settings: "tnum" 1;
  }
  #acb-{{ section.id }} .acb-lab {
    margin-top: 3px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.82;
  }
  #acb-{{ section.id }} .acb-sep {
    font-weight: 800;
    font-size: clamp(16px, 1.8vw, 22px);
    line-height: 1;
    opacity: 0.5;
    align-self: flex-start;
  }
  #acb-{{ section.id }} .acb-cta {
    display: inline-block;
    background: var(--acb-btn-bg);
    color: var(--acb-btn-fg);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 9px 20px;
    border-radius: 999px;
    white-space: nowrap;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1), opacity 240ms ease;
  }
  #acb-{{ section.id }} .acb-cta:hover { transform: translateY(-1px); opacity: 0.92; }
  #acb-{{ section.id }} .acb-close {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: 0;
    color: var(--acb-fg);
    opacity: 0.7;
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
    padding: 4px;
  }
  #acb-{{ section.id }} .acb-close:hover { opacity: 1; }
  #acb-{{ section.id }} .acb-sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
  @media only screen and (max-width: 768px) {
    #acb-{{ section.id }} .acb-inner { gap: 14px; padding: 10px 40px 10px 16px; }
    #acb-{{ section.id }} .acb-msg { font-size: 12px; letter-spacing: 0.06em; }
    #acb-{{ section.id }} .acb-num, #acb-{{ section.id }} .acb-sep { font-size: 16px; }
    #acb-{{ section.id }} .acb-lab { font-size: 9px; }
    #acb-{{ section.id }} .acb-cta { padding: 7px 14px; font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #acb-{{ section.id }} .acb-cta { transition: none; }
  }
{% endstyle %}

<div id="acb-{{ section.id }}" data-deadline="{{ section.settings.end_datetime }}" data-expire="{{ section.settings.on_expire }}">
  <div class="acb-inner">

    {% if section.settings.heading != blank %}
      <p class="acb-msg">{{ section.settings.heading }}</p>
    {% endif %}

    {% if section.settings.show_timer %}
      <div class="acb-timer" role="timer" aria-hidden="true">
        <div class="acb-unit"><span class="acb-num" data-days>00</span><span class="acb-lab">{{ section.settings.label_days }}</span></div>
        <span class="acb-sep">:</span>
        <div class="acb-unit"><span class="acb-num" data-hours>00</span><span class="acb-lab">{{ section.settings.label_hours }}</span></div>
        <span class="acb-sep">:</span>
        <div class="acb-unit"><span class="acb-num" data-mins>00</span><span class="acb-lab">{{ section.settings.label_mins }}</span></div>
        <span class="acb-sep">:</span>
        <div class="acb-unit"><span class="acb-num" data-secs>00</span><span class="acb-lab">{{ section.settings.label_secs }}</span></div>
      </div>
      <span class="acb-sr" data-sr></span>
    {% endif %}

    {% if section.settings.cta_label != blank %}
      <a class="acb-cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
    {% endif %}

    {% if section.settings.dismissible %}
      <button class="acb-close" type="button" aria-label="Dismiss announcement">&times;</button>
    {% endif %}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('acb-{{ section.id }}');
    if (!root) return;

    {% if section.settings.dismissible %}
    var KEY = 'acb_dismissed_{{ section.id }}';
    try { if (localStorage.getItem(KEY) === '{{ section.settings.end_datetime }}') { root.style.display = 'none'; return; } } catch (e) {}
    var closeBtn = root.querySelector('.acb-close');
    if (closeBtn) closeBtn.addEventListener('click', function () {
      root.style.display = 'none';
      try { localStorage.setItem(KEY, '{{ section.settings.end_datetime }}'); } catch (e) {}
    });
    {% endif %}

    {% if section.settings.show_timer %}
    var raw = (root.getAttribute('data-deadline') || '').trim();
    var target = new Date(raw.replace(' ', 'T')).getTime();
    var timer = root.querySelector('.acb-timer');
    var sr = root.querySelector('[data-sr]');
    var elD = root.querySelector('[data-days]'), elH = root.querySelector('[data-hours]'),
        elM = root.querySelector('[data-mins]'), elS = root.querySelector('[data-secs]');

    if (isNaN(target)) { if (timer) timer.style.display = 'none'; return; }

    function pad(n) { return (n < 10 ? '0' : '') + n; }

    function tick() {
      var diff = target - Date.now();
      if (diff <= 0) {
        clearInterval(iv);
        if ('{{ section.settings.on_expire }}' === 'hide') { root.style.display = 'none'; }
        else {
          if (timer) timer.style.display = 'none';
          var msg = root.querySelector('.acb-msg');
          if (msg && '{{ section.settings.expired_text }}' !== '') { msg.textContent = '{{ section.settings.expired_text }}'; }
        }
        return;
      }
      var d = Math.floor(diff / 86400000);
      var h = Math.floor(diff % 86400000 / 3600000);
      var m = Math.floor(diff % 3600000 / 60000);
      var s = Math.floor(diff % 60000 / 1000);
      elD.textContent = pad(d); elH.textContent = pad(h); elM.textContent = pad(m); elS.textContent = pad(s);
      if (sr) sr.textContent = 'Offer ends in ' + d + ' days ' + h + ' hours';
    }

    tick();
    var iv = setInterval(tick, 1000);
    {% endif %}
  })();
</script>

{% schema %}
{
  "name": "Announcement + Countdown",
  "class": "acb-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Announcement text", "default": "Biggest ever sale live now" },
    {
      "type": "header",
      "content": "Countdown timer"
    },
    { "type": "checkbox", "id": "show_timer", "label": "Show countdown timer", "default": true },
    {
      "type": "text",
      "id": "end_datetime",
      "label": "Sale end date and time",
      "info": "Format: YYYY-MM-DD HH:MM (24-hour), store timezone. Example: 2026-07-31 23:59",
      "default": "2026-07-31 23:59"
    },
    {
      "type": "select",
      "id": "on_expire",
      "label": "When timer ends",
      "options": [
        { "value": "hide", "label": "Hide the banner" },
        { "value": "message", "label": "Show a message" }
      ],
      "default": "hide"
    },
    { "type": "text", "id": "expired_text", "label": "Expired message", "default": "Sale has ended" },
    { "type": "text", "id": "label_days", "label": "Days label", "default": "Days" },
    { "type": "text", "id": "label_hours", "label": "Hours label", "default": "Hrs" },
    { "type": "text", "id": "label_mins", "label": "Minutes label", "default": "Min" },
    { "type": "text", "id": "label_secs", "label": "Seconds label", "default": "Sec" },
    {
      "type": "header",
      "content": "Call to action"
    },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    {
      "type": "header",
      "content": "Style"
    },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#e92e30" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#ffffff" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#e92e30" },
    { "type": "checkbox", "id": "dismissible", "label": "Allow visitors to dismiss", "default": false }
  ],
  "presets": [
    { "name": "Announcement + Countdown" }
  ]
}
{% endschema %}