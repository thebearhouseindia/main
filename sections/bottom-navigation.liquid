  .bn_child .bn_child_link {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  .bn_container .hide_icon {
    display: none;
  }
  .bn_child:hover .show_icon {
    display: none;
  }
  .bn_child:hover .hide_icon {
    display: block;
  }
  .bn_container .active .show_icon {
    display: none;
  }
  .bn_container .active .show_icon {
    display: none;
  }
  .bn_container .active .hide_icon {
    display: block;
  }
</style>

<script>
  let bnChildLinks = document.querySelectorAll('bottom-nav .bn_child_link');
  let currentPageUrl = new URL(window.location.href);

  function normalizeUrl(url) {
    let normalizedUrl = new URL(url);
    let path = normalizedUrl.pathname;

    if (path.startsWith('/account/login')) {
      return '/account';
    }

    normalizedUrl.search = '';
    normalizedUrl.hash = '';
    return normalizedUrl.pathname;
  }

  let normalizedCurrentPageUrl = normalizeUrl(currentPageUrl);

  bnChildLinks.forEach((bnChildLink) => {
    let normalizedLinkUrl = normalizeUrl(bnChildLink.href);

    if (normalizedLinkUrl === normalizedCurrentPageUrl) {
      bnChildLink.classList.add('active');
    } else {
      bnChildLink.classList.remove('active');
    }
  });
</script>

