      const collectionUrl = tab.dataset.collectionUrl;
      const menu = document.querySelector(`[data-menu="${id}"]`);

      resetAll();
      tab.classList.add('active');
      updateActiveTitle();

      if (hasMenu && menu) {
        menu.classList.add('active');
        const firstLink = menu.querySelector('a');
        menu.querySelector('li')?.classList.add('active');

        if (firstLink && firstLink.pathname !== currentPath) {
          window.location.href = firstLink.href;
        }
      } else if (!hasMenu && collectionUrl) {
        const urlPath = new URL(collectionUrl, window.location.origin).pathname;
        if (urlPath !== currentPath) {
          window.location.href = collectionUrl;
        }
      }
    });
  });


  menus.forEach(menu => {
    menu.querySelectorAll('li').forEach(li => {
      li.addEventListener('click', () => {
        menu.querySelectorAll('li').forEach(i => i.classList.remove('active'));
        li.classList.add('active');
        updateActiveTitle();
      });
    });
  });

});
