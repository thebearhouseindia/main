<div class="container-here">
  <div class="collection_title">
    {{ section.settings.title_text }}
    <div class="product-col-title"></div>
  </div>
  <div class="content-wrapper">
    <div class="collection-tabs">
      {% for block in section.blocks %}

        {% assign menu = linklists[block.settings.menu] %}
        {% assign has_menu = false %}
        {% if menu != blank and menu.links.size > 0 %}
          {% assign has_menu = true %}
        {% endif %}

       <button
          type="button"
          class="collection-tab{% if forloop.first %} active{% endif %}"
          data-tab="{{ block.id }}"
          data-collection-url="{{ block.settings.collection_url }}"
          data-has-menu="{% if has_menu %}true{% else %}false{% endif %}"
        > 

          {% if block.settings.image %}
            <div class="img-here">
              <img src="{{ block.settings.image | image_url }}" alt="" width="" height="" loading="lazy">
            </div>
          {% endif %}
          <span>{{ block.settings.title }}</span>
        </button>

      {% endfor %}
    </div>
    <div class="collection-categories relative{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}">
      {% for block in section.blocks %}

        {% assign menu = linklists[block.settings.menu] %}
        {% assign has_menu = false %}
        {% if menu != blank and menu.links.size > 0 %}
          {% assign has_menu = true %}
        {% endif %}

        {% if has_menu %}
          <div
            class="category-menu{% if forloop.first %} active{% endif %}"
            data-menu="{{ block.id }}"
          >
            <ul>
              {% for link in menu.links %}
                <li class="{% if forloop.first and forloop.parentloop.first %}active{% endif %}">
                  <a href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

      {% endfor %}
    </div>

  </div>
</div>

