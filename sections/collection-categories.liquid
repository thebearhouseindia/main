<script>
  document.addEventListener('DOMContentLoaded', () => {

    const tabs = document.querySelectorAll('.collection-tab');
    const menus = document.querySelectorAll('.category-menu');
    const currentPath = window.location.pathname;
    const titleBox = document.querySelector('.product-col-title');
    const categoryBox = document.querySelector('.collection-categories');

    /* ============================= */
    function resetAll() {
      tabs.forEach(t => t.classList.remove('active'));
      menus.forEach(m => {
        m.classList.remove('active');
        m.querySelectorAll('li').forEach(li => li.classList.remove('active'));
      });
    }

    function updateActiveTitle() {
      const activeTab = document.querySelector('.collection-tab.active span');
      if (activeTab && titleBox) {
        titleBox.textContent = activeTab.textContent;
      }
    }

    function updateCategoryBorder(hasMenu) {
      if (!categoryBox) return;

      if (hasMenu) {
        categoryBox.style.borderTop = "";
        categoryBox.style.borderBottom = "";
        categoryBox.style.display = "";
      } else {
        categoryBox.style.display = "none";
        categoryBox.style.borderTop = "none";
        categoryBox.style.borderBottom = "none";
      }
    }

    /* ============================= */
    let restored = false;

    /* ===== Restore for collection URL without menu ===== */
    tabs.forEach(tab => {
      const hasMenu = tab.dataset.hasMenu === "true";
      const collectionUrl = tab.dataset.collectionUrl;

      if (!hasMenu && collectionUrl) {
        const urlPath = new URL(collectionUrl, window.location.origin).pathname;
        if (urlPath === currentPath) {
          resetAll();
          tab.classList.add('active');
          updateActiveTitle();
          updateCategoryBorder(false);
          restored = true;
        }
      }
    });

    /* ===== Restore for category menu links ===== */
    menus.forEach(menu => {
      menu.querySelectorAll('a').forEach(link => {
        if (link.pathname === currentPath) {
          const id = menu.dataset.menu;
          const tab = document.querySelector(`.collection-tab[data-tab="${id}"]`);
          const hasMenu = tab?.dataset.hasMenu === "true";

          resetAll();

          tab?.classList.add('active');
          menu.classList.add('active');
          link.closest('li').classList.add('active');

          updateActiveTitle();
          updateCategoryBorder(hasMenu);
          restored = true;
        }
      });
    });

    /* ===== If nothing matched ===== */
    if (!restored) {
      resetAll();
      if (titleBox) titleBox.textContent = "";
      updateCategoryBorder(false);
    }

    /* ============================= */
    /* ===== TAB CLICK ===== */
    tabs.forEach(tab => {
      tab.addEventListener('click', e => {
        e.preventDefault();

        const id = tab.dataset.tab;
        const hasMenu = tab.dataset.hasMenu === "true";
        const collectionUrl = tab.dataset.collectionUrl;
        const menu = document.querySelector(`[data-menu="${id}"]`);

        resetAll();
        tab.classList.add('active');
        updateActiveTitle();
        updateCategoryBorder(hasMenu);

        if (hasMenu && menu) {
          menu.classList.add('active');
          const firstLink = menu.querySelector('a');
          menu.querySelector('li')?.classList.add('active');

          if (firstLink && firstLink.pathname !== currentPath) {
            window.location.href = firstLink.href;
          }

        } else if (!hasMenu && collectionUrl) {
          const urlPath = new URL(collectionUrl, window.location.origin).pathname;
          if (urlPath !== currentPath) {
            window.location.href = collectionUrl;
          }
        }
      });
    });

    /* ============================= */
    /* ===== MENU CLICK ===== */
    menus.forEach(menu => {
      menu.querySelectorAll('li').forEach(li => {
        li.addEventListener('click', () => {
          menu.querySelectorAll('li').forEach(i => i.classList.remove('active'));
          li.classList.add('active');
        });
      });
    });

  });
</script>