<script>
document.addEventListener('DOMContentLoaded', () => {
  const tabs = document.querySelectorAll('.collection-tab');
  const menus = document.querySelectorAll('.category-menu');
  const currentPath = window.location.pathname;
  const titleBox = document.querySelector('.product-col-title');

  function resetAll() {
    tabs.forEach(t => t.classList.remove('active'));
    menus.forEach(m => {
      m.classList.remove('active');
      m.querySelectorAll('li').forEach(li => li.classList.remove('active'));
    });
  }

  function updateActiveTitle() {
    const activeTab = document.querySelector('.collection-tab.active span');
    if (activeTab && titleBox) {
      titleBox.textContent = activeTab.textContent;
    }
  }

  let restored = false;


  tabs.forEach(tab => {
    const hasMenu = tab.dataset.hasMenu === "true";
    const collectionUrl = tab.dataset.collectionUrl;

    if (!hasMenu && collectionUrl) {
      const urlPath = new URL(collectionUrl, window.location.origin).pathname;
      if (urlPath === currentPath) {
        resetAll();
        tab.classList.add('active');
        restored = true;
        updateActiveTitle();
      }
    }
  });

  menus.forEach(menu => {
    menu.querySelectorAll('a').forEach(link => {
      if (link.pathname === currentPath) {
        const id = menu.dataset.menu;

        resetAll();

        document
          .querySelector(`.collection-tab[data-tab="${id}"]`)
          ?.classList.add('active');

        menu.classList.add('active');
        link.closest('li').classList.add('active');

        restored = true;
        updateActiveTitle();
      }
    });
  });

  if (!restored) {
    resetAll();

    tabs.forEach(t => t.classList.remove('active'));
    menus.forEach(m => {
      m.classList.remove('active');
      m.querySelectorAll('li').forEach(li => li.classList.remove('active'));
    });
