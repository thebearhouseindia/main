{{ 'shop-by-color.css' | asset_url | stylesheet_tag }}

<section class="shop-by-color">
  <div class="shop-by-color__inner">

    {% if section.settings.title != blank %}
      <h2 class="shop-by-color__title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="shop-by-color__divider"></div>

    <div class="shop-by-color__list">
      {% for block in section.blocks %}
        {% assign is_active = false %}
        {% if block.settings.collection_url != blank %}
          {% if request.path == block.settings.collection_url %}
            {% assign is_active = true %}
          {% endif %}
        {% endif %}

        <a
          href="{{ block.settings.collection_url | default: '#' }}"
          class="shop-by-color__item{% if is_active %} is-active{% endif %}"
          {{ block.shopify_attributes }}
        >
          <span
            class="shop-by-color__swatch"
            style="background-color: {{ block.settings.color }};"
          ></span>
          <span class="shop-by-color__label">{{ block.settings.label }}</span>
        </a>
      {% endfor %}
    </div>

  </div>
</section>

<style>
.shop-by-color {
  background: #f5f5f3;
  padding: 32px 20px 28px;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.shop-by-color__inner {
  max-width: 1200px;
  margin: 0 auto;
  text-align: center;
}

.shop-by-color__title {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #1a1a1a;
  margin: 0 0 18px;
}

.shop-by-color__divider {
  width: 100%;
  height: 1px;
  background: #ddd;
  margin-bottom: 20px;
}

.shop-by-color__list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
}

.shop-by-color__item {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 14px 7px 9px;
  border-radius: 999px;
  border: 1.5px solid transparent;
  background: transparent;
  text-decoration: none;
  color: #1a1a1a;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  transition: border-color 0.2s ease, background 0.2s ease;
  cursor: pointer;
}

.shop-by-color__item:hover {
  border-color: #aaa;
  background: #fff;
}

.shop-by-color__item.is-active {
  border-color: #1a1a1a;
  background: #fff;
}

.shop-by-color__swatch {
  display: inline-block;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 1px solid rgba(0,0,0,0.12);
  flex-shrink: 0;
}

.shop-by-color__label {
  line-height: 1;
}
</style>

{% schema %}
{
  "name": "Shop By Color",
  "tag": "section",
  "class": "section-shop-by-color",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "SHOP BY COLOR"
    }
  ],
  "blocks": [
    {
      "type": "color_item",
      "name": "Color",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Color Label",
          "default": "Blue"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Swatch Color",
          "default": "#3b5fa0"
        },
        {
          "type": "url",
          "id": "collection_url",
          "label": "Collection URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Color",
      "blocks": [
        { "type": "color_item", "settings": { "label": "Blue",  "color": "#3b5fa0" } },
        { "type": "color_item", "settings": { "label": "Black", "color": "#1a1a1a" } },
        { "type": "color_item", "settings": { "label": "Brown", "color": "#7b4f2e" } },
        { "type": "color_item", "settings": { "label": "Olive", "color": "#6b6b3a" } },
        { "type": "color_item", "settings": { "label": "White", "color": "#ffffff" } },
        { "type": "color_item", "settings": { "label": "Pink",  "color": "#f0739a" } },
        { "type": "color_item", "settings": { "label": "Navy",  "color": "#1f3460" } },
        { "type": "color_item", "settings": { "label": "Cream", "color": "#f5c842" } },
        { "type": "color_item", "settings": { "label": "Green", "color": "#1a6b5e" } },
        { "type": "color_item", "settings": { "label": "Grey",  "color": "#b0b0b0" } }
      ]
    }
  ]
}
{% endschema %}
