<div class="page-width page-width--narrow page-content common-page-wrap">
  {%- render 'breadcrumbs' -%}
  <header class="section-header">
    <h1 class="section-header__title">{{ page.title }}</h1>
  </header>

  <div class="page-section page-content rte rte--nomargin">
    {{ page.content }}
  </div>
</div>
<script>
document.addEventListener("DOMContentLoaded", function(){
  let firstOpened = false;

  document.querySelectorAll('.page-content p').forEach(function(p){

    const strong = p.querySelector('strong');
    if(!strong) return;

    const ul = p.nextElementSibling;
    if(!ul || ul.tagName !== 'UL') return;

    p.classList.add('returns-toggle-row');   // add class to P

    const btn = document.createElement('span');
    btn.className = 'returns-toggle';
    btn.innerText = '+';
    p.appendChild(btn);
    ul.style.display = 'none';
    if(!firstOpened){
      ul.style.display = 'block';
      btn.innerText = '−';
      p.classList.add('is-open');
      firstOpened = true;
    }
    function toggle(){
      if(ul.style.display === 'none'){
          ul.style.display = 'block';
          btn.innerText = '−';
          p.classList.add('is-open');
      }else{
          ul.style.display = 'none';
          btn.innerText = '+';
          p.classList.remove('is-open');
      }
    }
    btn.addEventListener('click', function(e){
      e.stopPropagation();
      toggle();
    });
    p.addEventListener('click', toggle);
  });
});
</script>
{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section"
}
{% endschema %}

