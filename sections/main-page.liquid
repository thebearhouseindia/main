{% comment %} --- {% endcomment %}
.page-content p{
    display:flex;
    align-items:center;
}
.returns-toggle-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  cursor:pointer;
  padding:12px 0;
}
.returns-toggle{
  font-size:22px;
  font-weight:400;
  line-height:1;
  transition:0.3s;
}
.returns-toggle-row.is-open .returns-toggle{
  transform:rotate(180deg);
}
</style>  
