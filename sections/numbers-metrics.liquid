<section class="numbers-metrics" id="numbers-{{ section.id }}">
  <div class="numbers-container">

    {% if section.settings.heading != blank %}
      <h2 class="numbers-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="numbers-grid">
      {% for block in section.blocks %}
        <div class="numbers-box">
          <p class="numbers-small-title">{{ block.settings.small_title }}</p>
          <h3 class="numbers-big-text">{{ block.settings.big_text }}</h3>
          <p class="numbers-description">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<style>
.numbers-metrics {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: #F2F2F2;    
}

.numbers-container {
  max-width: 1230px;
  width: 100%;
  padding: 0px 10px;
  margin: auto;
  text-align: center;
}

.numbers-heading {
  margin-bottom: 28px;
  font-size: 30px;
  font-weight: 500;
}

.numbers-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
}

.numbers-box {
  background: #ffffff;
  padding: 50px;
  border-radius: 10px;
  text-align: left;
}

.numbers-small-title {
    font-size: 13px;
    color: #3F3F3F;
    text-transform: uppercase;
    margin-bottom: 14px;
    font-weight: 300;
    line-height: 150%;
}

.numbers-big-text {
    font-size: 60px;
    font-weight: 400;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    color: #3f3f3f;
}

.numbers-description {
  font-size: 16px;
  color: #3f3f3f;
}
@media(max-width: 768px) {
  .numbers-metrics {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  .numbers-heading {
    margin-bottom: 10px;
    font-size: 16px;
    text-align: left;
  }
  .numbers-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
  }
  .numbers-box {
    border-radius: 6px;
    padding: 16px;
  }
  .numbers-big-text {
    font-size: 40px;
    margin-bottom: 10px;
    padding-bottom: 10px;
  }
  .numbers-description {
    font-size: 13px;
  }
  .numbers-small-title {
    font-size: 12px;
  }
}
</style>

{% schema %}
{
  "name": "Numbers Metrics",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Top Heading",
      "default": "THE NUMBERS THAT DEFINE US"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding Desktop",
      "min": 20,
      "max": 100,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding Desktop",
      "min": 20,
      "max": 100,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top Padding Mobile",
      "min": 20,
      "max": 100,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom Padding Mobile",
      "min": 20,
      "max": 100,
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Metric Box",
      "settings": [
        {
          "type": "text",
          "id": "small_title",
          "label": "Small Title",
          "default": "TRUSTED BY"
        },
        {
          "type": "text",
          "id": "big_text",
          "label": "Big Number Text",
          "default": "1M+"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Men across India wear The Bear House"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Numbers Metrics"
    }
  ]
}
{% endschema %}
