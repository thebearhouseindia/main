
<div id="popup-drawer">
  <div class="popup-overlay"></div>
    <div class="popup-panel">
    <span class="popup-close">✕</span>
    <div class="popup-chart-text">SIZE CHART</div>

    <div class="wrapper-chart">
        {% render 'size-snippets' %}
        {% render 'top-measurement' %}
    </div>
  </div>
</div>

<style>
#popup-drawer {
  position: fixed;
  inset: 0;
  z-index: 999999;
  pointer-events: none;
}

.popup-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.6);
  opacity: 0;
  transition: 0.4s;
}

.popup-panel {
  position: fixed;
  top: 0;
  right: 0;
  width: 34%;
  max-width: 100%;
  height: 100vh;
  background: #fff;
  transform: translateX(100%);
  transition: 0.4s ease;
  overflow-y: auto;
  padding: 40px;
  overflow-x: auto;
}



.popup-panel img {
  width: 100%;
  object-fit: cover;
  height: 100%;
}

#popup-drawer.active {
  pointer-events: all;
}

#popup-drawer.active .popup-overlay {
  opacity: 1;
  display: block;
}

#popup-drawer.active .popup-panel {
  transform: translateX(0);
}

.popup-close {
  position: absolute;
  top: 30px;
  right: 20px;
  font-size: 20px;
  cursor: pointer;
  color: #000000 !important;
  display: none;
}

span.popup-close {
  border: 1px solid #000000;
  width: 40px !important;
  height: 40px !important;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  padding: 4px !important;
  z-index: 5;
}

.popup-panel {
  scrollbar-width: none;
}

.popup-panel::-webkit-scrollbar {
  display: none;
}

/* Responsive */

@media(max-width:1536px){
.popup-panel {
    position: fixed;
    top: 0;
    right: 0;
    width: 40%;
}
}

@media(max-width:1440px){
.popup-panel {
 width: 44%;
}

}

@media(max-width:1280px){
    .popup-panel {
        width: 50%;
    }
}

@media(max-width:768px){
  .popup-panel {
    width: 100%;
    max-width: unset;
  }
  .popup-panel img {
    width: 300%;
  }
.popup-close {
    top: 9px;
    right: 16px;
    font-size: 16px;
    border: unset !important;
}
  span.popup-close {
    width: 30px !important;
    height: 30px !important;
  }
.popup-chart-text {
    font-size: 16px;
    padding: 0px 0px 16px;
    text-align: center;
}

.popup-panel {
    padding: 17px 10px;
    height: 80vh;
}
.popup-chart-text {
    font-size: 16px;
    padding: 0px 0px 16px;
    text-align: center;
}

.popup-panel {
    padding: 17px 10px;
}

.size-tab {
    font-size: 13px;
    padding: 8px 12px;
}

.size-chart-tabs {
    margin-bottom: 16px;
    padding-top: 16px;
}

}

@media(max-width:473px){
  .popup-panel img {
    width: 260%;
  }
}

@media(max-width:400px){
  .popup-panel img {
    width: 340%;
  }
}

@media(max-width:380px){
  .popup-panel img {
    width: 259%;
  }
}

@media(max-width:370px){
  .popup-panel img {
    width: 332%;
  }
}
</style>

