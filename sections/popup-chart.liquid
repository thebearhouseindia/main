<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
$(document).ready(function () {

  // Open
  $('#btn-chart').on('click', function () {
    $('#popup-drawer').addClass('active');
    $('.popup-close')
      .css('display', 'flex')
      .hide()
      .fadeIn();
  });

  // Close
  $('.popup-close, .popup-overlay').on('click', function () {
    $('#popup-drawer').removeClass('active');
    $('.popup-close').fadeOut(function () {
      $(this).css('display', 'none');
    });
  });

  if ($(window).width() <= 768) {

    // Open measure panel
    $('.measurement-text-here').on('click', function(){
      $('.measure-wrapper').addClass('active');
      $('.size-chart-wrapper').css('visibility','hidden');
    });

    // Close measure panel
    $('.arrow-btn, .measure-wrapper .popup-close').on('click', function(){
      $('.measure-wrapper').removeClass('active');
      $('.size-chart-wrapper').css('visibility','visible');
    });

  }

});
</script>