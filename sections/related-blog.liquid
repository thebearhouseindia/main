
{% comment %} LOGIC BLOG TAG SLIDER {% endcomment %}

{% style %}
#shopify-section-{{ section.id }}{
  padding-top:{{ section.settings.padding_top }}px;
  padding-bottom:{{ section.settings.padding_bottom }}px;
  background:{{ section.settings.color_background }};
}


.swiper-slide.logic-blog-slide {
    flex: none;
}
.swiper-wrapper.wrapper-logic {
    display: flex;
}
section.logic-blog {
    overflow: hidden;
    max-width: 1120px;
    margin: 0 auto;
}
.logic-blog-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0px 0px 40px 0px;
}
.logic-blog-arrows {
    display: flex;
    gap:12px;
  }
  .logic-blog-arrows img {
    width: 24px;
    height: 24px;
}
h2.logic-blog-title {
    font-family: 'Roboto';
    font-weight: 700;
      font-size: 48px;
       line-height: 100%;
    letter-spacing: 0%;
    color:#010101;
}
.swiper-points.swiper-pagination.swiper-pagination-bullets.swiper-pagination-horizontal {
    display: none;
}
h2.heading-blog {
    text-align: center;
}

@media(max-width:1536px){
  section.logic-blog {
    margin: 0px 100px;
    overflow: hidden;
}
}
@media(max-width:1440px){
  section.logic-blog {
    margin: 0px 40px;
    overflow: hidden;
}
}

@media(max-width:768px){
#shopify-section-{{ section.id }}{
  padding-top:{{ section.settings.mobile_padding_top }}px;
  padding-bottom:{{ section.settings.mobile_padding_bottom }}px;
}
  section.logic-blog {
        margin: 0;
        overflow: hidden;
        padding: 0px 16px;
    }
  h2.logic-blog-title { font-size: 28px;}  
  .logic-blog-head {margin: 0px 0px 24px 0px;}
  h2.heading-blog {
    text-align: left;
}
}
{% endstyle %}

<section class="logic-blog" id="{{section.settings.section-id}}">

  {% if section.settings.tag_name!= blank %}
    
<div class="logic-blog-head">
  <h2 class="logic-blog-title">{{ section.settings.tag_name }}</h2>

  <div class="logic-blog-arrows">
    <div class="logic-blog-prev arrow">
      <img src="https://cdn.shopify.com/s/files/1/0651/8430/1301/files/Frame_6_d9ade543-ea44-4877-8d61-0a8099e1bb69.png?v=1766663509">
    </div>
    <div class="logic-blog-next arrow">
      <img src="https://cdn.shopify.com/s/files/1/0651/8430/1301/files/Frame_7_780c5158-f853-4b8e-a5b6-fefb18ce4274.png?v=1766663528">

    </div>
  </div>
</div>
    
  {% endif %}
<h2 class="heading-blog">{{ section.settings.heading }}</h2>


  <div class="swiper logic-blog-swiper">
    <div class="swiper-wrapper wrapper-logic">

      {% assign selected_blog = blogs[section.settings.blog_handle] %}
      {% assign tag = section.settings.tag_name | strip | downcase %}

      {% if selected_blog != blank %}
        {% for article in selected_blog.articles %}
          {% assign article_tags = article.tags | join: ',' | downcase %}
          {% if article_tags contains tag %}
            <div class="swiper-slide logic-blog-slide">
              {%- render 'article-card',article: article -%}
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}

    </div>

    <div class="swiper-points swiper-pagination"></div>
{% comment %} 
    <div class="logic-blog-arrows">
      <div class="logic-blog-prev"><img src="https://cdn.shopify.com/s/files/1/0651/8430/1301/files/Frame_7_780c5158-f853-4b8e-a5b6-fefb18ce4274.png?v=1766663528" width="" height=""></div>
      <div class="logic-blog-next"><img src="https://cdn.shopify.com/s/files/1/0651/8430/1301/files/Frame_6_d9ade543-ea44-4877-8d61-0a8099e1bb69.png?v=1766663509" width="" height=""></div>
    </div> {% endcomment %}

  </div>

</section>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded',()=>{
new Swiper('#shopify-section-{{ section.id }} .logic-blog-swiper',{
  slidesPerView:1.2,
  spaceBetween:12,
  loop:false,
  navigation:{
    nextEl:'#shopify-section-{{ section.id }} .logic-blog-next',
    prevEl:'#shopify-section-{{ section.id }} .logic-blog-prev'
  },
  pagination:{el:'#shopify-section-{{ section.id }} .swiper-pagination'},
  breakpoints:{
    768:{slidesPerView:2},
    1024:{slidesPerView:3}
  }
});
});
</script>
{% schema %}
{
  "name":"Logic Blog Tag Slider",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"From Our Blog"},
    {"type":"text","id":"section-id","label":"Section Id"},
    {"type":"blog","id":"blog_handle","label":"Select Blog"},
    {"type":"text","id":"tag_name","label":"Blog Tag Name (Exact)"},
    {"type":"range","id":"padding_top","label":"Desktop Padding Top","min":0,"max":120,"step":4,"default":40},
    {"type":"range","id":"padding_bottom","label":"Desktop Padding Bottom","min":0,"max":120,"step":4,"default":40},
    {"type":"range","id":"mobile_padding_top","label":"Mobile Padding Top","min":0,"max":80,"step":4,"default":20},
    {"type":"range","id":"mobile_padding_bottom","label":"Mobile Padding Bottom","min":0,"max":80,"step":4,"default":20},
    {"type":"color","id":"color_background","label":"Background","default":"#ffffff"}
  ],
  "presets":[{"name":"Blog Slider"}]
}
{% endschema %}
