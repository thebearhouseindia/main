<style>
  .occasion-card:hover img {
    scale: 1.1;
  }
  .shop-by-occasions {
    padding: 60px 0;
  }

  .shop-occasion-heading {
    margin-bottom: 24px;
  }

  .occasion-grid {
    display: flex;
    gap: 6px;
  }

  .occasion-right {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    max-width: 58.9%;
    width: 100%;
  }

  .occasion-card {
      position: relative;
      overflow: hidden;
      border-radius: 10px;
      height: 100%;
      width: auto;
  }

  .occasion-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .occasion-card img {
    transition: all 0.3s ease-in-out;
  }
  .occasion-card.large {
    height: 100%;
    max-width: 41.1%;
    width: 100%;
    overflow: hidden;
  }

  .occasion-label {
      position: absolute;
      bottom: 24px;
      left: 0;
      right: 0;
      margin: auto;
      color: #fff;
      font-size: 20px;
      font-weight: 400;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      text-align: center;
      font-family: 'Roboto';
  }
  @media (max-width: 1551px) {
    .occasion-label {
      font-size: 11px;
      bottom: 10px;
      letter-spacing: 0;
    }
  }
  @media (max-width: 768px) {
    .occasion-grid {
      flex-direction: column;
      gap: 2px;
    }
    .shop-by-occasions {
      padding: 30px 0;
    }
    .shop-occasion-heading {
      margin-bottom: 10px;
    }
    .occasion-card.large {
      max-width: 100%;
    }
    .occasion-right {
      max-width: 100%;
      gap: 2px;
    }
    .shop-by-occasions .page-width {
      padding: 0px 10px;
    }
  }
</style>

<div class="shop-by-occasions">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="shop-occasion-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="occasion-grid">
      {% for block in section.blocks %}
        {% if forloop.first %}
          <!-- Left Large Card -->
          <a href="{{ block.settings.link }}" class="occasion-card large" aria-label="{{ block.settings.heading | default: block.settings.link | split: '/collections/' | last | replace: '-', ' ' | strip | capitalize | escape }}">
            {% if block.settings.image %}
              {{
                block.settings.image
                | image_url: width: 1000
                | image_tag:
                  widths: '400, 600, 800, 1000',
                  sizes: '(max-width: 768px) 100vw, 60vw',
                  loading: 'lazy',
                  alt: block.settings.label
              }}
            {% endif %}
            <span class="occasion-label">{{ block.settings.label }}</span>
          </a>
        {% endif %}
      {% endfor %}

      <div class="occasion-right">
        {% for block in section.blocks offset: 1 %}
          <a href="{{ block.settings.link }}" class="occasion-card small" aria-label="{{ block.settings.heading | default: block.settings.link | split: '/collections/' | last | replace: '-', ' ' | strip | capitalize | escape }}">
            {% if block.settings.image %}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  widths: '300, 500, 800',
                  sizes: '(max-width: 768px) 100vw, 20vw',
                  loading: 'lazy',
                  alt: block.settings.label
              }}
            {% endif %}
            <span class="occasion-label">{{ block.settings.label }}</span>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop by Occasions",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Occasions"
    }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Party"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 7,
  "presets": [
    {
      "name": "Shop by Occasions",
      "blocks": [
        { "type": "occasion" },
        { "type": "occasion" },
        { "type": "occasion" },
        { "type": "occasion" },
        { "type": "occasion" }
      ]
    }
  ]
}
{% endschema %}
