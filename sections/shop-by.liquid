<style>
#shopify-section-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  width: 100%;
  display: inline-block;
}
.shop-price-size {
  max-width: 50%;
  width: 100%;
}
.shop-by-size {
  background-color: #EAEAEA;
  padding: 40px 50px;
  border-radius: 10px;
}

.shop-by-size__inner {
  display: flex;
  align-items: start;
  justify-content: center;
  gap: 20px;
  flex-direction: column;
}

.shop-by-size__sizes {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.shop-by-size__size {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border: 1px solid #e92e30;
    background: transparent;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.2;
    text-decoration: none;
    transition: all 0.25s ease;
    border-radius: 999px;
}

.shop-by-size__size:hover {
  background: #e92e30;
  color: #fff;
}

.size-collection.shop-by-size {
  background-color: transparent;
  padding: 0px;
  border-radius: 0px;
  color: #3f3f3f;
}
.size-collection .shop-by-size__heading {
  color: #3f3f3f;
}
.size-collection .shop-by-size__size {
  border: 1px solid #3f3f3f;
  color: #3f3f3f;
}
.size-collection .shop-by-size__size:hover,
.size-collection .shop-by-size__size.active {
  background: #3f3f3f;
  color: #ffffff;
}

@media(max-width:1440px){
  #shopify-section-{{ section.id }} {
    padding-left: 20px !important;
    padding-right: 20px !important;
  }
}



@media (max-width: 768px){
  #shopify-section-{{ section.id }} {
    padding-left: 10px !important;
    padding-right: 10px !important;
  }
  .shop-price-size {
    max-width: 100%;
    width: 100%;
  }
  .shop-by-size__inner {
    gap: 10px;
    flex-direction: column;
    align-items: flex-start;
  }
  .shop-by-size__size {
    padding: 7px 12px 7px;
    font-size: 12px;
  }
  .shop-by-size {
    padding: 20px 16px;
  }
    #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
}
</style>

<div class="shop-by-size {{ section.settings.custom_class }}">
  <div class="shop-by-size__inner">
    {% if section.settings.heading != blank %}
      <h2 class="shop-by-size__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="shop-by-size__sizes">
      {% for block in section.blocks %}
        {% assign block_url = block.settings.url %}
        {% assign block_path = block_url | split: shop.url | last %}
        {% assign current_path = request.path %}
        {% if block.settings.size_label != blank and block.settings.collection != blank %}
          <a
            href="{{ block.settings.collection.url }}"
            class="shop-by-size__size {% if current_path == block_path %}active{% endif %}"
          >
            {{ block.settings.size_label }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop By Size",
  "class": "shop-price-size",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY SIZE"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 52,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 52,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Size",
      "settings": [
        {
          "type": "text",
          "id": "size_label",
          "label": "Size Label",
          "default": "XS"
        },
        {
          "type": "url",
          "id": "collection",
          "label": "Redirect Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Size",
      "blocks": [
        { "type": "size" },
        { "type": "size" },
        { "type": "size" }
      ]
    }
  ]
}
{% endschema %}
