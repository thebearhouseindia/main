{%- comment -%}
  Gift Card Promo block - The Bear House
  Dynamic height: the card grows with content, the image fills the height (no fixed band).
  Optional "Minimum height" only sets a floor (0 = fully automatic).
  Usage: {% render 'giftcard-promo', block: block %}
{%- endcomment -%}

{%- liquid
  assign target = ''
  if block.settings.open_new_tab
    assign target = 'target="_blank" rel="noopener"'
  endif
-%}

{% style %}
#gcp-{{ block.id }} {
  background: {{ block.settings.section_bg }};
  padding-top: {{ block.settings.padding_top }}px;
  padding-bottom: {{ block.settings.padding_bottom }}px;
}
#gcp-{{ block.id }} .gcp-wrapper {
  max-width: {{ block.settings.max_width }}px;
  margin: 0 auto;
}
#gcp-{{ block.id }} .gcp-grid {
  display: grid;
  grid-template-columns: {{ block.settings.image_width }}% calc(100% - {{ block.settings.image_width }}% - {{ block.settings.gap }}px);
  gap: {{ block.settings.gap }}px;
  align-items: stretch;
  {% if block.settings.min_height > 0 %}min-height: {{ block.settings.min_height }}px;{% endif %}
  border-radius: {{ block.settings.card_radius }}px;
  overflow: hidden;
}
#gcp-{{ block.id }} .gcp-media {
  background: {{ block.settings.panel_bg }};
  display: flex;
  align-items: center;
  justify-content: center;
  padding: {{ block.settings.image_padding }}px;
  overflow: hidden;
}
#gcp-{{ block.id }} .gcp-media img,
#gcp-{{ block.id }} .gcp-media svg {
  width: 100%;
  height: 100%;
  object-fit: {{ block.settings.image_fit }};
  border-radius: {{ block.settings.image_radius }}px;
  display: block;
}
#gcp-{{ block.id }} .gcp-media img.gcp-img-mobile { display: none; }
#gcp-{{ block.id }} .gcp-body {
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: left;
  padding: 8px {{ block.settings.text_padding }}px;
  font-family: 'Roboto', sans-serif;
}
#gcp-{{ block.id }} .gcp-eyebrow {
  margin: 0 0 6px;
  color: {{ block.settings.eyebrow_color }};
  font-size: 12px;
  line-height: 1.3;
}
#gcp-{{ block.id }} .gcp-heading {
  margin: 0 0 8px;
  color: {{ block.settings.heading_color }};
  font-size: 19px;
  line-height: 1.15;
  font-weight: 700;
}
#gcp-{{ block.id }} .gcp-desc {
  color: {{ block.settings.text_color }};
  font-size: 13px;
  line-height: 1.45;
  margin: 0 0 14px;
}
#gcp-{{ block.id }} .gcp-desc p { margin: 0 0 6px; }
#gcp-{{ block.id }} .gcp-desc p:last-child { margin-bottom: 0; }
#gcp-{{ block.id }} .gcp-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  gap: 8px;
  width: fit-content;
  min-width: 0;
  background: {{ block.settings.button_bg }};
  color: {{ block.settings.button_text }};
  text-decoration: none;
  padding: 11px 22px;
  border-radius: {{ block.settings.button_radius }}px;
  font-size: 15px;
  font-weight: 600;
  transition: opacity .2s ease;
}
#gcp-{{ block.id }} .gcp-btn:hover { opacity: .9; }
#gcp-{{ block.id }} .gcp-btn svg { width: 18px; height: 18px; flex: 0 0 auto; }
#gcp-{{ block.id }} .gcp-footer {
  margin-top: 12px;
  color: {{ block.settings.footer_color }};
  font-size: 12px;
  line-height: 1.4;
}

{% if block.settings.image_position == 'right' %}
#gcp-{{ block.id }} .gcp-media { order: 2; }
#gcp-{{ block.id }} .gcp-body { order: 1; }
{% endif %}

@media screen and (max-width: 767px) {
  {% if block.settings.mobile_image != blank %}
  #gcp-{{ block.id }} .gcp-media img.gcp-img-desktop { display: none; }
  #gcp-{{ block.id }} .gcp-media img.gcp-img-mobile { display: block; }
  {% endif %}

  /* mobile column proportions */
  #gcp-{{ block.id }} .gcp-grid {
    grid-template-columns: {{ block.settings.image_width_mobile }}% calc(100% - {{ block.settings.image_width_mobile }}% - {{ block.settings.gap }}px);
  }

  {% if block.settings.mobile_layout == 'stacked' %}
  /* stacked: image on top at its natural proportions (no fixed band) */
  #gcp-{{ block.id }} .gcp-grid { grid-template-columns: 1fr; }
  #gcp-{{ block.id }} .gcp-media { order: 1; }
  #gcp-{{ block.id }} .gcp-media img,
  #gcp-{{ block.id }} .gcp-media svg { height: auto; }
  #gcp-{{ block.id }} .gcp-body { order: 2; }
  #gcp-{{ block.id }} .gcp-btn { width: 100%; }
  {% endif %}

  #gcp-{{ block.id }} .gcp-body { padding: 8px {{ block.settings.text_padding_mobile }}px; text-align: left; }
  #gcp-{{ block.id }} .gcp-eyebrow { font-size: 10px; }
  #gcp-{{ block.id }} .gcp-heading { font-size: 14px; }
  #gcp-{{ block.id }} .gcp-desc { font-size: 10px; margin-bottom: 10px; }
  #gcp-{{ block.id }} .gcp-btn { padding: 8px 16px; font-size: 14px; }
  #gcp-{{ block.id }} .gcp-footer { font-size: 10px; }
}
{% endstyle %}

<div
  id="gcp-{{ block.id }}"
  class="gcp-promo{% if block.settings.custom_class != blank %} {{ block.settings.custom_class }}{% endif %}"
>
  <div class="gcp-wrapper">
    <div class="gcp-grid">

      <div class="gcp-media">
        {% if block.settings.image != blank %}
          <img
            class="gcp-img-desktop"
            src="{{ block.settings.image | image_url: width: 1200 }}"
            alt="{{ block.settings.heading | escape }}"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            loading="lazy">
        {% else %}
          {{ 'image' | placeholder_svg_tag }}
        {% endif %}

        {% if block.settings.mobile_image != blank %}
          <img
            class="gcp-img-mobile"
            src="{{ block.settings.mobile_image | image_url: width: 800 }}"
            alt="{{ block.settings.heading | escape }}"
            width="{{ block.settings.mobile_image.width }}"
            height="{{ block.settings.mobile_image.height }}"
            loading="lazy">
        {% endif %}
      </div>

      <div class="gcp-body">
        {% if block.settings.eyebrow != blank %}
          <div class="gcp-eyebrow">{{ block.settings.eyebrow }}</div>
        {% endif %}
        {% if block.settings.heading != blank %}
          <h2 class="gcp-heading">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="gcp-desc">{{ block.settings.description }}</div>
        {% endif %}
        {% if block.settings.button_label != blank %}
          <a href="{{ block.settings.button_url }}" class="gcp-btn" {{ target }}>
            {% if block.settings.show_icon %}
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M20 12v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-8M2 7h20v5H2V7Zm10 0v14M12 7S9 2 6.5 2 4 5 6.5 5 12 7 12 7Zm0 0s3-5 5.5-5S20 5 17.5 5 12 7 12 7Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {% endif %}
            <span>{{ block.settings.button_label }}</span>
          </a>
        {% endif %}
        {% if block.settings.footer_text != blank %}
          <div class="gcp-footer">{{ block.settings.footer_text }}</div>
        {% endif %}
      </div>

    </div>
  </div>
</div>
