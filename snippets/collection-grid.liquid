{% comment %} 
<script>
document.addEventListener("click", function(e) {
  if (e.target.closest(".collection-sidebar__group ul.no-bullets.tag-list li.tag")) {

    // Create style tag (only once)
    if (!document.getElementById("loader-style")) {
      const style = document.createElement("style");
      style.id = "loader-style";
      style.innerHTML = `
        #page-loader {
          position: fixed;
          inset: 0;
          background: rgba(255,255,255,0.85);
          display: flex;
          align-items: center;
          justify-content: center;
          z-index: 9999;
        }

        #page-loader .spinner {
          width: 40px;
          height: 40px;
          border: 4px solid #ddd;
          border-top: 4px solid #000;
          border-radius: 50%;
          animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
          to { transform: rotate(360deg); }
        }
      `;
      document.head.appendChild(style);
    }

    // Create loader
    const loader = document.createElement("div");
    loader.id = "page-loader";
    loader.innerHTML = '<div class="spinner"></div>';
    document.body.appendChild(loader);

    // Delay reload
    setTimeout(function() {
      location.reload();
    }, 1000);
  }
});
</script> {% endcomment %}


{% comment %} <script>
document.addEventListener("DOMContentLoaded", function () {

  const filter = document.querySelector(".collection-filter");
  if (!filter) return;

  function handlePosition() {

    const rect = filter.getBoundingClientRect();
    const viewportHeight = window.innerHeight;

    // If filter enters bottom 20% of viewport
    if (rect.top >= viewportHeight * 0.8) {
      filter.classList.add("fixed-bottom");
    } else {
      filter.classList.remove("fixed-bottom");
    }
  }

  window.addEventListener("scroll", handlePosition);
  window.addEventListener("resize", handlePosition);

});
</script> {% endcomment %}




 {% comment %} <script>
document.addEventListener("DOMContentLoaded", function () {

  const filter = document.querySelector(".collection-filter");
  if (!filter) return;

  function handleSticky() {
    const scrollTop = window.scrollY;
    const windowHeight = window.innerHeight;
    const fullHeight = document.documentElement.scrollHeight;

    const scrolledPercentage = (scrollTop + windowHeight) / fullHeight;

    if (scrolledPercentage >= 0.8) {
      filter.classList.add("remove-sticky");
    } else {
      filter.classList.remove("remove-sticky");
    }
  }

  window.addEventListener("scroll", handleSticky);
});
</script>  {% endcomment %}


{% comment %}
Snippet Arguments
- collection: Liquid 'collection' or 'search' object
- items: Paginated 'collection.products' or 'search.results' list. Cannot be pulled from the the 'collection' object passed in above
- enable_sidebar: boolean
- filter_style: 'sidebar' or 'drawer'
- enable_sort: boolean
- enable_collection_count
- per_row
- mobile_flush_grid
- quick_shop_enable
{% endcomment %}

{% liquid
  if collection.products
    assign count = collection.products_count
    assign count_label = 'collections.general.items_with_count'
  endif

  if collection.results
    assign count = collection.results_count
    assign count_label = 'general.search.result_count'
  endif

  assign filters = collection.filters
  assign sort_by = collection.sort_by
  assign default_sort_by = collection.default_sort_by
  assign sort_options = collection.sort_options
  assign current_filter_size = 0

  for filter in filters
    assign current_filter_size = current_filter_size | plus: filter.active_values.size
  endfor
%}

<div class="collection-grid__wrapper">
  {% comment %} {% if collection.metafields.custom.collection_tabs %}
    <div class="collection-tab-wrapper">
      <div class="collection-tabs">
        {% for tab in collection.metafields.custom.collection_tabs.value %}
          <button
            class="collection-tab-btn {% if forloop.first %}active{% endif %}"
            data-target="{{ tab.tab_tag }}">
            {{ tab.tab_name }}
          </button>
        {% endfor %}
      </div>
    </div>
  {% endif %} {% endcomment %}


  <div class="collection-filter">
    <div class="collection-filter_inner">
      <div class="collection-filter__item collection-filter__item--sort">
        <div class="collection-filter__sort-container">
        {%- assign sort_by = sort_by | default: default_sort_by -%}
        <label for="SortBy" class="hidden-label">{{ 'collections.sorting.title' | t }}</label>
        <select name="SortBy" id="SortBy" data-default-sortby="{{ default_sort_by }}">
          <option value="title-ascending"{% if sort_by == default_sort_by %} selected="selected"{% endif %}>{{ 'collections.sorting.title' | t }}</option>
          {%- for option in sort_options -%}
          <option value="{{ option.value }}"{% if option.value == sort_by %} selected="selected"{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
        </div>
    </div>
    <div class="collection-filter__item collection-filter__item--drawer">
      <button
        type="button"
        class="js-drawer-open-collection-filters btn btn--tertiary{% unless current_filter_size == 0 %} btn--tertiary-active{% endunless %}"
        aria-controls="FilterDrawer">
          <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-filter" viewBox="0 0 64 64"><title>icon-filter</title><path d="M48 42h10m-10 0a5 5 0 1 1-5-5 5 5 0 0 1 5 5ZM7 42h31M16 22H6m10 0a5 5 0 1 1 5 5 5 5 0 0 1-5-5Zm41 0H26"/></svg>
          {{ 'collections.filters.title_tags' | t }}
          {%- if current_filter_size > 0 -%}
              ({{ current_filter_size }})
          {%- endif -%}
      </button>
    </div>

    <div class="collection-filter__item collection-filter__item--count small--hide">
      {%- if enable_collection_count -%}
        {{ count_label | t: count: count }}
      {%- endif -%}
    </div>
    </div>

    <div class="facets_slide desk_facets">
      <div class="facet-btn" data-grid="4">
        <svg width="22" height="14" viewBox="0 0 22 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g clip-path="url(#clip0_35_9)">
        <path d="M4 0H0V14H4V0Z"/>
        <path d="M10 0H6V14H10V0Z"/>
        <path d="M16 0H12V14H16V0Z"/>
        <path d="M22 0H18V14H22V0Z"/>
        </g>
        <defs>
        <clipPath id="clip0_35_9">
        <rect width="22" height="14" fill="white"/>
        </clipPath>
        </defs>
        </svg>
      </div>
      <div class="facet-btn" data-grid="5">
        <svg width="28" height="14" viewBox="0 0 28 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g clip-path="url(#clip0_35_3)">
        <path d="M4 0H0V14H4V0Z"/>
        <path d="M10 0H6V14H10V0Z"/>
        <path d="M16 0H12V14H16V0Z"/>
        <path d="M22 0H18V14H22V0Z"/>
        <path d="M28 0H24V14H28V0Z"/>
        </g>
        <defs>
        <clipPath id="clip0_35_3">
        <rect width="28" height="14" fill="white"/>
        </clipPath>
        </defs>
        </svg>
      </div>
    </div>

    <div class="facets_slide mobile_facets">
      <div class="facet-btn" data-grid="4">
        <svg width="22" height="14" viewBox="0 0 22 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g clip-path="url(#clip0_35_9)">
        <path d="M4 0H0V14H4V0Z"/>
        <path d="M10 0H6V14H10V0Z"/>
        </g>
        <defs>
        <clipPath id="clip0_35_9">
        <rect width="22" height="14" fill="white"/>
        </clipPath>
        </defs>
        </svg>
      </div>
      <div class="facet-btn" data-grid="5">
        <svg width="28" height="14" viewBox="0 0 28 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g clip-path="url(#clip0_35_3)">
        <path d="M4 0H0V14H4V0Z"/>
        </g>
        <defs>
        <clipPath id="clip0_35_3">
        <rect width="28" height="14" fill="white"/>
        </clipPath>
        </defs>
        </svg>
      </div>
    </div>

  </div>

  <div class="grid facets_slide_grid grid--uniform{% if mobile_flush_grid %} small--grid--flush{% endif %}"{% unless enable_collection_count %} data-scroll-to{% endunless %}>
    {% comment %} {%- for item in items -%}
      {%- if item.object_type == 'product' -%}
        {%- render 'product-grid-item',
          product: item,
          per_row: per_row,
          quick_shop_enable: quick_shop_enable
        -%}
      {%- else -%}
        {%- render 'search-grid-item',
          item: item,
          per_row: per_row
        %}
      {%- endif -%}
    {%- endfor -%} {% endcomment %}



    {%- for item in items -%}
      {%- if item.object_type == 'product' -%}

        <div class="product-item" data-collection-tags="{{ item.tags | join: ',' }}">
          {%- render 'product-grid-item',
            product: item,
            per_row: per_row,
            quick_shop_enable: quick_shop_enable
          -%}
        </div>

      {%- else -%}
        {%- render 'search-grid-item',
          item: item,
          per_row: per_row
        %}
      {%- endif -%}
    {%- endfor -%}

  </div>
</div>

{%- if enable_sidebar and filter_style != 'drawer' and collection.filters.size > 0 -%}
{% comment %}
  Sidebar enabled but not in drawer mode, only show filter button on mobile
{% endcomment %}
{% style %}
@media screen and (min-width: 769px) {
  .collection-filter__item--drawer {
    display: none;
  }
  .collection-filter__item--count {
    text-align: left;
  }
  html[dir="rtl"] .collection-filter__item--count {
    text-align: right;
  }
}
{% endstyle %}
{%- endif -%}

{%- if enable_sidebar == false or collection.filters.size == 0 -%}
{% comment %}
    Disable sidebar & filter features
{% endcomment %}
{% style %}
.collection-filter__item--drawer {
  display: none;
}
.collection-filter__item--count {
  text-align: left;
}
html[dir="rtl"] .collection-filter__item--count {
  text-align: right;
}
{% endstyle %}
{%- endif -%}

{%- unless enable_sort -%}
{% style %}
.collection-filter__sort-container {
  display: none;
}
{% endstyle %}
{%- endunless -%}



<script>
document.addEventListener("DOMContentLoaded", function () {

  /* ----------------------------------------------------------
     TAB FILTER FUNCTIONALITY
  ---------------------------------------------------------- */
 {% comment %} const buttons = document.querySelectorAll(".collection-tab-btn");
  const products = document.querySelectorAll(".product-item");

  buttons.forEach(button => {
    button.addEventListener("click", function () {

      // Active state update
      buttons.forEach(btn => btn.classList.remove("active"));
      this.classList.add("active");

      const target = this.getAttribute("data-target").trim().toLowerCase();

      products.forEach(product => {
        let tags = product.getAttribute("data-collection-tags")
                          .split(",")
                          .map(tag => tag.trim().toLowerCase());

        if (target === "all" || tags.includes(target)) {
          product.style.display = "block";
        } else {
          product.style.display = "none";
        }
      });

    });
  });  {% endcomment %}


  /* ----------------------------------------------------------
     GRID SWITCHER FUNCTIONALITY (4 / 5)
  ---------------------------------------------------------- */
  const facetButtons = document.querySelectorAll(".facet-btn");
  const gridContainer = document.querySelector(".facets_slide_grid");

  // Default selection (4) from Refresh
  let selectedGrid = localStorage.getItem("selectedGrid") || "4";

  // Apply saved/default grid class
  gridContainer.classList.add("grid-" + selectedGrid);

  // Set correct active button on load
  facetButtons.forEach(btn => {
    if (btn.dataset.grid === selectedGrid) {
      btn.classList.add("active");
    }
  });

  // Button click event
  facetButtons.forEach(button => {
    button.addEventListener("click", function () {

      const value = this.dataset.grid; // "4" or "5"

      // Remove previous layout classes
      gridContainer.classList.remove("grid-4", "grid-5");

      // Add new class
      gridContainer.classList.add("grid-" + value);

      // Save user selection for refresh
      localStorage.setItem("selectedGrid", value);

      // Active button UI
      facetButtons.forEach(b => b.classList.remove("active"));
      this.classList.add("active");
    });
  });


});


</script> 

