<style>
.mobile-nav__social {
  margin: 0px;
  gap: 2px;
}
.account-social .mobile-nav__social-item {
  border: none;
}
.account-social {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  padding: 16px 10px;
  border-top: 1px solid rgba(0, 0, 0, 0.1);
}
.account-social .mobile-nav__social a {
  padding: 4.42px 8px;
  width: auto;
  background: #F4F4F4;
}
.mobile-menu-collection_image {
  width: 114px;
  height: 114px;
  object-fit: cover;
  margin-bottom: 6px;
  border-radius: 6px;
}
.mobile-submenu {
  position: absolute;
  top: 0;
  left: 100%;      
  width: 100%;
  background: #F9F9F9;
  transition: transform 0.4s ease;
  z-index: 100;
  height: 100%;
  overflow-y: auto;
  transform: translateX(0);
  padding: 10px;
}
.mobile-submenu.active {
  transform: translateX(-100%);
}
.mobile-nav-inner {
  margin: 0px;
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 2px;
}
.menu-block-top {
  position: relative;
  padding: 10px 10px 4px;
