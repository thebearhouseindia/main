{%- comment -%}
  Product schema for The Bear House
  Return policy: 7 days, Rs 50 fee (matches /pages/return-policy)
  Delivery: 1-4 business days (customer promise)
{%- endcomment -%}

{%- assign product_url = shop.url | append: product.url -%}
{%- assign brand_name = 'The Bear House' -%}
{%- assign currency_code = shop.currency -%}
{%- assign product_publish_date = product.published_at | date: '%Y-%m-%d' -%}

{%- assign show_rating = false -%}
{%- assign rating_value_raw = product.metafields.reviews.rating.value -%}
{%- assign rating_count_raw = product.metafields.reviews.rating_count -%}
{%- if rating_value_raw != blank and rating_count_raw != blank -%}
  {%- assign rating_value_num = rating_value_raw | plus: 0.0 -%}
  {%- assign rating_count_num = rating_count_raw | plus: 0 -%}
  {%- if rating_count_num >= 3 and rating_value_num >= 4.0 and rating_value_num <= 5.0 -%}
    {%- assign show_rating = true -%}
  {%- endif -%}
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "@id": "{{ product_url }}#product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "image": [
    {%- for img in product.images limit: 5 -%}
      "{{ img | image_url: width: 1200 }}"{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
  "mpn": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
  {%- if product.selected_or_first_available_variant.barcode != blank -%}
  "gtin": {{ product.selected_or_first_available_variant.barcode | json }},
  {%- endif -%}
  "brand": { "@type": "Brand", "name": "{{ brand_name }}" },
  "manufacturer": { "@type": "Organization", "name": "{{ brand_name }}", "url": "{{ shop.url }}" },
  "category": {{ product.type | json }},
  "url": "{{ product_url }}",
  {%- if show_rating -%}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ rating_value_num | round: 1 }}",
    "reviewCount": "{{ rating_count_num }}",
    "bestRating": "5",
    "worstRating": "1"
  },
  {%- endif -%}
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "@id": "{{ product_url }}?variant={{ variant.id }}#offer",
      "url": "{{ product_url }}?variant={{ variant.id }}",
      "sku": {{ variant.sku | default: variant.id | json }},
      "mpn": {{ variant.sku | default: variant.id | json }},
      {%- if variant.barcode != blank -%}
      "gtin": {{ variant.barcode | json }},
      {%- endif -%}
      "price": "{{ variant.price | money_without_currency | remove: ',' }}",
      "priceCurrency": "{{ currency_code }}",
      "priceValidUntil": "{{ 'now' | date: '%s' | plus: 15552000 | date: '%Y-%m-%d' }}",
      "validFrom": "{{ product_publish_date }}",
      "availability": "{%- if variant.available -%}https://schema.org/InStock{%- else -%}https://schema.org/OutOfStock{%- endif -%}",
      "itemCondition": "https://schema.org/NewCondition",
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "IN",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteWindow",
        "merchantReturnDays": 7,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/ReturnShippingFees",
        "returnShippingFeesAmount": {
          "@type": "MonetaryAmount",
          "value": "50",
          "currency": "{{ currency_code }}"
        }
      },
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": {
          "@type": "MonetaryAmount",
          "value": "0",
          "currency": "{{ currency_code }}"
        },
        "shippingDestination": {
          "@type": "DefinedRegion",
          "addressCountry": "IN"
        },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "transitTime": {
            "@type": "QuantitativeValue",
            "minValue": 1,
            "maxValue": 4,
            "unitCode": "DAY"
          }
        }
      },
      "seller": {
        "@type": "Organization",
        "name": "{{ brand_name }}",
        "url": "{{ shop.url }}"
      }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>