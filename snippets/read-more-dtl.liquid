<script>
document.addEventListener("DOMContentLoaded", function () {

  const article = document.querySelector('.article__body');

  if(!article) return;

  const fullHeight = article.scrollHeight;        // real content height
  const collapseHeight = fullHeight * 0.7;        // 70%

  article.style.maxHeight = collapseHeight + "px";
  article.style.overflow = "hidden";

  const btn = document.createElement('div');
  btn.className = 'read-more-btn';
  btn.innerText = 'Read More';
  article.after(btn);

  btn.addEventListener('click', function(){
      article.style.maxHeight = fullHeight + "px";
      btn.remove();
  });

});
</script>

<style>
.article__body{
    position: relative;
    overflow: hidden;
    transition: max-height 0.6s ease;
}

.read-more-btn{
    display: inline-block;
    margin-top: 30px;
    font-family: Roboto;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    color:#3F3F3F;
    width: 100%;
    text-decoration: underline;
    text-align: center;
}

</style>