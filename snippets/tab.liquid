{%- liquid
  assign output_tab = true
  if title == blank and content == blank
    assign output_tab = false
  endif
-%}
{%- if output_tab -%}
  <div class="collapsibles-wrapper collapsibles-wrapper--border-bottom">
    <button type="button"
      class="label collapsible-trigger collapsible-trigger-btn collapsible-trigger-btn--borders collapsible--auto-height{% if force_open %} is-open{% endif %}"
      aria-controls="Product-content-{{ id }}"
      {% if force_open %}aria-expanded="true"{% endif %}>
      
      {{ title }}

      <span class="collapsible-trigger__icon" role="presentation">
        <!-- PLUS (default) -->
        <svg class="icon-plus" viewBox="0 0 24 24">
          <path d="M12 5v14M5 12h14" stroke="#000" stroke-width="2" fill="none" stroke-linecap="round"/>
        </svg>

        <!-- MINUS (visible only when open) -->
        <svg class="icon-minus" viewBox="0 0 24 24">
          <path d="M5 12h14" stroke="#000" stroke-width="2" fill="none" stroke-linecap="round"/>
        </svg>
      </span>
    </button>
    <div id="Product-content-{{ id }}"
      class="collapsible-content collapsible-content--all{% if force_open %} is-open{% endif %}"
      {% if force_open %}style="height: auto;"{% endif %}>
      <div class="collapsible-content__inner rte">
        {{ content }}
        {% if title == "Manufactured & Marketed by" %}
          {% if product.tags contains 'made in india' %}
            <p><strong>Country of origin : India</strong></p>
          {% elsif product.tags contains 'made in China' %}
            <p><strong>Country of origin : China</strong></p>
          {% elsif product.tags contains 'made in Bangladesh' %}
            <p><strong>Country of origin : Bangladesh</strong></p>
          {% endif %}
         {% endif %}
      </div>
    </div>
  </div>
{%- endif -%}
