{% style %}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

.referrush-referral-page {
  font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: #ffffff;
  color: #1a1a1a;
  line-height: 1.5;
}

.referrush-referral-page .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

/* Button */
.referrush-referral-page .referrush-refer-btn {
  display: inline-block;
  background: #0a0a0a;
  color: #fff;
  padding: 16px 40px;
  font-size: 20px;
  font-weight: 600;
  border: none;
  border-radius: 9999px;
  cursor: pointer;
  text-transform: capitalize;
  transition: transform 0.2s;
  box-shadow: inset 2px 4px 8.5px rgba(255, 255, 255, 0.48);
}
.referrush-referral-page .referrush-refer-btn:hover { transform: scale(1.02); }
.referrush-referral-page .referrush-refer-btn:active { transform: scale(0.98); }

/* ========== HERO SECTION ========== */

/* Mobile Hero */
.referrush-referral-page .hero-mobile { display: none; }

/* Desktop Hero */
.referrush-referral-page .hero-desktop {
  background: #fff;
}
.referrush-referral-page .hero-desktop .container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 40px;
}
.referrush-referral-page .hero-content {
  padding: 20px;
}
.referrush-referral-page .hero-title {
  font-size: 48px;
  font-weight: 500;
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin-bottom: 16px;
  color: #1a1a1a;
}
.referrush-referral-page .hero-subtitle {
  font-size: 18px;
  color: #4a4a4a;
  margin-bottom: 32px;
  text-transform: capitalize;
}
.referrush-referral-page .hero-image-wrapper {
  display: flex;
  justify-content: center;
}
.referrush-referral-page .hero-image {
  width: 100%;
  max-height: 90vh;
  object-fit: cover;
}

/* Mobile Hero Styles */
.referrush-referral-page .hero-header {
  display: flex;
  min-height: 140px;
  align-items: center;
  justify-content: center;
  padding: 40px 16px 56px;
  background: #EE4741;
}
.referrush-referral-page .hero-logo-img {
  height: 32px;
  object-fit: contain;
}
.referrush-referral-page .hero-logo-placeholder {
  display: flex;
  height: 48px;
  width: 120px;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  border: 2px dashed rgba(0,0,0,0.3);
  background: rgba(0,0,0,0.1);
  font-size: 10px;
  font-weight: 500;
  color: rgba(0,0,0,0.7);
}
.referrush-referral-page .hero-card {
  margin-top: -24px;
  padding: 40px 20px;
  background: #fff;
  border-radius: 28px 28px 0 0;
  box-shadow: 0 -4px 20px rgba(0,0,0,0.12);
}
.referrush-referral-page .hero-card-inner {
  max-width: 500px;
  margin: 0 auto;
}
.referrush-referral-page .hero-title-mobile {
  font-size: 24px;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.02em;
  color: #1a1a1a;
}

/* Mobile Product Gallery */
.referrush-referral-page .hero-gallery {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 16px -20px 0;
  padding: 8px 0;
  overflow: hidden;
}
.referrush-referral-page .product-card-blur {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 120px;
  height: 180px;
  border-radius: 16px;
  overflow: hidden;
  opacity: 0.9;
  filter: blur(1px);
  background: #d1d1d1;
}
.referrush-referral-page .product-card-blur--left { left: -30px; }
.referrush-referral-page .product-card-blur--right { right: -30px; }
.referrush-referral-page .product-card-blur img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.referrush-referral-page .product-card-featured {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 165px;
  height: 200px;
  border-radius: 12px;
  border: 2px solid #EE4741;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  overflow: hidden;
}
.referrush-referral-page .product-card-featured img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.referrush-referral-page .product-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 145px;
  height: 180px;
  border-radius: 12px;
  border: 2px dashed #999;
  background: #d1d1d1;
}
.referrush-referral-page .product-placeholder-text {
  font-size: 11px;
  font-weight: 500;
  color: #666;
  text-align: center;
  padding: 0 8px;
}

.referrush-referral-page .hero-subtitle-mobile {
  margin-top: 8px;
  font-size: 12px;
  font-weight: 500;
  text-align: center;
  color: #4a4a4a;
}
.referrush-referral-page .hero-cta-mobile {
  margin-top: 24px;
  text-align: center;
}
.referrush-referral-page .hero-cta-mobile .referrush-refer-btn {
  padding: 14px 32px;
  font-size: 16px;
}

/* ========== STEPS SECTION ========== */
.referrush-referral-page .steps {
  padding: 100px 0;
  background: #fff;
}
.referrush-referral-page .section-header {
  margin-bottom: 24px;
  padding: 0 8px;
}
.referrush-referral-page .section-header h2 {
  font-size: 36px;
  font-weight: 400;
  margin-bottom: 12px;
  color: #1a1a1a;
}
.referrush-referral-page .section-header p {
  font-size: 18px;
  font-weight: 300;
  color: #4a4a4a;
  text-transform: capitalize;
}
.referrush-referral-page .steps-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.referrush-referral-page .step-card {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 32px;
  border-radius: 20px;
  background: #e8e8e8;
  border: 1px solid #EE4741;
}
.referrush-referral-page .step-number {
  position: absolute;
  top: 8px;
  right: 8px;
  font-size: 18px;
  color: #4a4a4a;
  opacity: 0.35;
}
.referrush-referral-page .step-icon {
  order: -1;
  margin-bottom: 20px;
  color: #EE4741;
  filter: drop-shadow(0 4px 0 rgba(0,0,0,0.95));
}
.referrush-referral-page .step-icon svg {
  width: 64px;
  height: 90px;
}
.referrush-referral-page .step-card h3 {
  margin-top: 0;
  font-size: 18px;
  font-weight: 400;
  line-height: 1.4;
  color: #1a1a1a;
}
.referrush-referral-page .step-divider {
  height: 2px;
  background: #EE4741;
  border: none;
  margin: 12px 0;
}
.referrush-referral-page .step-card > p {
  font-size: 16px;
  font-weight: 300;
  color: #4a4a4a;
}

/* ========== FAQ SECTION ========== */
.referrush-referral-page .referrush-faq {
  padding: 80px 0;
  background: #fff;
}
.referrush-referral-page .referrush-faq-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
}
.referrush-referral-page .referrush-faq-intro {
  padding: 0 8px;
}
.referrush-referral-page .referrush-faq-intro h2 {
  font-size: 36px;
  font-weight: 400;
  margin-bottom: 16px;
  color: #1a1a1a;
}
.referrush-referral-page .referrush-faq-intro-divider {
  display: none;
}
.referrush-referral-page .referrush-faq-intro > p {
  font-size: 18px;
  font-weight: 300;
  color: #4a4a4a;
  line-height: 1.6;
}
.referrush-referral-page .referrush-faq-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.referrush-referral-page .referrush-faq-item {
  background: #e8e8e8;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: inset 2px 4px 8.5px rgba(0, 0, 0, 0.12);
}
.referrush-referral-page .referrush-faq-question {
  width: 100%;
  padding: 24px;
  background: none;
  border: none;
  font-size: 16px;
  font-weight: 300;
  text-align: left;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  color: #1a1a1a;
}
.referrush-referral-page .referrush-faq-arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  color: #4a4a4a;
  transition: transform 0.3s;
}
.referrush-referral-page .referrush-faq-arrow svg {
  width: 11px;
  height: 6px;
}
.referrush-referral-page .referrush-faq-item.active .referrush-faq-arrow { transform: rotate(180deg); }
.referrush-referral-page .referrush-faq-answer {
  padding: 0 24px;
  max-height: 0;
  overflow: hidden;
  transition: all 0.3s ease-in-out;
  font-size: 16px;
  color: #4a4a4a;
  opacity: 0.8;
}
.referrush-referral-page .referrush-faq-item.active .referrush-faq-answer {
  padding: 0 24px 24px;
  max-height: 200px;
}

/* Contact Card */
.referrush-referral-page .contact-card {
  background: #e8e8e8;
  border-radius: 19px;
  padding: 32px;
  text-align: center;
}
.referrush-referral-page .contact-card h3 {
  font-size: 23px;
  font-weight: 400;
  color: #1a1a1a;
  margin-bottom: 16px;
  text-transform: capitalize;
}
.referrush-referral-page .contact-card p {
  font-size: 16px;
  font-weight: 300;
  color: #4a4a4a;
  margin-bottom: 8px;
  letter-spacing: 0.5px;
}
.referrush-referral-page .contact-card strong {
  font-size: 14px;
  font-weight: 500;
  color: #1a1a1a;
}
.referrush-referral-page .contact-card--desktop {
  display: block;
  margin-top: 40px;
}
.referrush-referral-page .contact-section { display: none; }

/* ========== CTA SECTION ========== */
.referrush-referral-page .cta-section {
  padding: 96px 0;
  background: #EE4741;
}
.referrush-referral-page .cta-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32px;
  text-align: center;
}
.referrush-referral-page .cta-title {
  font-size: 48px;
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: #0a0a0a;
  margin: 0;
}
.referrush-referral-page .cta-subtitle {
  font-size: 18px;
  font-weight: 500;
  color: rgba(10, 10, 10, 0.7);
  max-width: 400px;
  margin: 0;
}
.referrush-referral-page .cta-btn {
  margin-top: 8px;
  display: inline-block;
  background: #0a0a0a;
  color: #fff;
  padding: 20px 40px;
  font-size: 20px;
  font-weight: 600;
  border: none;
  border-radius: 9999px;
  cursor: pointer;
  text-transform: capitalize;
  transition: transform 0.2s;
  box-shadow: inset 2px 4px 8.5px rgba(255, 255, 255, 0.48);
}
.referrush-referral-page .cta-btn:hover { transform: scale(1.02); }
.referrush-referral-page .cta-btn:active { transform: scale(0.98); }

/* ========== MOBILE STYLES ========== */
@media (max-width: 768px) {
  /* Hero Mobile */
  .referrush-referral-page .hero-desktop { display: none; }
  .referrush-referral-page .hero-mobile { display: block; }

  /* Steps Mobile */
  .referrush-referral-page .steps { padding: 80px 0; }
  .referrush-referral-page .section-header h2 { font-size: 28px; }
  .referrush-referral-page .section-header p { font-size: 14px; }
  .referrush-referral-page .steps-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    max-width: 500px;
    margin: 0 auto;
  }
  .referrush-referral-page .step-card {
    padding: 8px 8px 16px;
    border-radius: 11px;
  }
  .referrush-referral-page .step-number {
    top: 8px;
    right: 8px;
    font-size: 18px;
  }
  .referrush-referral-page .step-icon {
    order: 1;
    margin-top: 16px;
    margin-bottom: 0;
    display: flex;
    justify-content: center;
  }
  .referrush-referral-page .step-icon svg {
    width: 64px;
    height: 64px;
  }
  .referrush-referral-page .step-card h3 {
    margin-top: 24px;
    font-size: 14px;
  }
  .referrush-referral-page .step-card > p {
    font-size: 11px;
  }
  .referrush-referral-page .step-divider {
    margin: 4px 0;
    height: 1px;
  }

  /* FAQ Mobile */
  .referrush-referral-page .referrush-faq { padding: 0 0 0; }
  .referrush-referral-page .referrush-faq-grid { grid-template-columns: 1fr; gap: 40px; }
  .referrush-referral-page .referrush-faq-intro { margin-bottom: 0; }
  .referrush-referral-page .referrush-faq-intro h2 { font-size: 24px; }
  .referrush-referral-page .referrush-faq-intro > p { font-size: 14px; }
  .referrush-referral-page .referrush-faq-intro-divider {
    display: block;
    height: 1px;
    background: #EE4741;
    margin: 16px 0 24px;
  }
  .referrush-referral-page .referrush-faq-item { border-radius: 19px; }
  .referrush-referral-page .referrush-faq-answer { font-size: 14px; }
  .referrush-referral-page .referrush-faq-question .referrush-faq-number { display: inline; }
  .referrush-referral-page .contact-card--desktop { display: none; }
  .referrush-referral-page .referrush-faq-list { max-width: 500px; margin: 0 auto; }

  /* Contact Mobile */
  .referrush-referral-page .contact-section {
    display: block;
    padding: 48px 0;
    background: #fff;
  }
  .referrush-referral-page .contact-card--mobile {
    max-width: 400px;
    margin: 0 auto;
    padding: 32px 48px;
    box-shadow: inset 2px 4px 8.5px rgba(0, 0, 0, 0.12);
  }

  /* CTA Mobile */
  .referrush-referral-page .cta-section { padding: 64px 0; }
  .referrush-referral-page .cta-inner { gap: 24px; }
  .referrush-referral-page .cta-title { font-size: 24px; }
  .referrush-referral-page .cta-subtitle { font-size: 14px; }
  .referrush-referral-page .cta-btn {
    padding: 16px 32px;
    font-size: 16px;
  }
}

{% endstyle %}

